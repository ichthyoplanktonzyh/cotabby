    "Add at least one language so Lingrove knows what to write in.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف لغة واحدة على الأقل كي يعرف Lingrove ما الذي سيكتبه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge mindestens eine Sprache hinzu, damit Lingrove weiß, in welcher Sprache es schreiben soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade al menos un idioma para que Lingrove sepa en qué escribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez au moins une langue pour que Lingrove sache dans quelle langue écrire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम एक भाषा जोड़ें ताकि Lingrove जान सके कि क्या लिखना है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan setidaknya satu bahasa agar Lingrove tahu bahasa yang digunakan untuk menulis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi almeno una lingua, così Lingrove sa in quale lingua scrivere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingroveが文章を書く言語を少なくとも1つ追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove가 작성할 내용을 알 수 있도록 언어를 하나 이상 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione pelo menos um idioma para o Lingrove saber em que idioma escrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте хотя бы один язык, чтобы Lingrove знал, на каком языке писать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove'nin hangi dilde yazacağını bilmesi için en az bir dil ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少添加一种语言，让拾语知道要使用哪种语言写作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少加入一種語言，讓拾語知道要使用哪種語言寫作。"
          }
        }
      }
    },
    "Add models from your LM Studio library (~/.lmstudio/models) to the picker above. Downloads still save to Lingrove's own folder.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف نماذج من مكتبة LM Studio لديك (~/.lmstudio/models) إلى القائمة أعلاه. تظل التنزيلات محفوظة في مجلد Lingrove الخاص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle aus deiner LM-Studio-Bibliothek (~/.lmstudio/models) zum obigen Auswahlfeld hinzufügen. Downloads werden weiterhin in Lingroves eigenem Ordner gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade modelos de tu biblioteca de LM Studio (~/.lmstudio/models) al selector de arriba. Las descargas siguen guardándose en la carpeta propia de Lingrove."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des modèles depuis votre bibliothèque LM Studio (~/.lmstudio/models) au sélecteur ci-dessus. Les téléchargements sont toujours enregistrés dans le dossier de Lingrove."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी LM Studio लाइब्रेरी (~/.lmstudio/models) से ऊपर के चयनकर्ता में मॉडल जोड़ें। डाउनलोड Lingrove के अपने फ़ोल्डर में ही सेव होंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan model dari pustaka LM Studio Anda (~/.lmstudio/models) ke pemilih di atas. Unduhan tetap disimpan di folder Lingrove sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi al selettore i modelli dalla libreria di LM Studio (~/.lmstudio/models). I download vengono comunque salvati nella cartella di Lingrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studioのライブラリ（~/.lmstudio/models）からモデルを上の選択欄に追加します。ダウンロード先は引き続きLingrove専用フォルダです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio 라이브러리(~/.lmstudio/models)의 모델을 위 목록에 추가합니다. 다운로드는 여전히 Lingrove 전용 폴더에 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione modelos da sua biblioteca do LM Studio (~/.lmstudio/models) ao seletor acima. Os downloads continuam sendo salvos na pasta própria do Lingrove."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте модели из библиотеки LM Studio (~/.lmstudio/models) в список выше. Загрузки по-прежнему сохраняются в собственной папке Lingrove."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarıdaki seçiciye LM Studio kitaplığınızdaki modelleri (~/.lmstudio/models) ekleyin. İndirmeler yine Lingrove'nin kendi klasörüne kaydedilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 LM Studio 模型库（~/.lmstudio/models）中的模型添加到上方选择器。下载的模型仍会保存到拾语的专用文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 LM Studio 模型庫（~/.lmstudio/models）中的模型加入上方選擇器。下載的模型仍會儲存在拾語自己的資料夾。"
          }
        }
      }
    },
    "Allow new suggestions when text follows the caret on the same line.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح باقتراحات جديدة عند وجود نص بعد المؤشر في السطر نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Vorschläge zulassen, wenn in derselben Zeile Text hinter dem Cursor steht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow new suggestions when text follows the caret on the same line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite nuevas sugerencias aunque haya texto después del cursor en la misma línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser de nouvelles suggestions même si du texte suit le curseur sur la même ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसी पंक्ति में कर्सर के बाद टेक्स्ट होने पर भी नए सुझाव दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan saran baru saat ada teks setelah kursor di baris yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti nuovi suggerimenti quando c’è testo dopo il cursore sulla stessa riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ行でカーソルの後に文字があっても、新しい候補を生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 줄에서 커서 뒤에 텍스트가 있어도 새 제안을 허용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite novas sugestões quando há texto após o cursor na mesma linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешать новые подсказки, когда в строке есть текст после курсора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı satırda imleçten sonra metin varken yeni önerilere izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一行的光标后仍有文字时，允许生成新建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一行的游標後仍有文字時，允許產生新建議。"
          }
        }
      }
    },
