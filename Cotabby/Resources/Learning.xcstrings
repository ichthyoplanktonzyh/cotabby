    "Apple Intelligence rejected a guided-generation request Lingrove sent.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض Apple Intelligence طلب التوليد الموجّه الذي أرسله Lingrove."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence hat eine von Lingrove gesendete Anfrage zur geführten Generierung abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence rechazó una solicitud de generación guiada enviada por Lingrove."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence a refusé une requête de génération guidée envoyée par Lingrove."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ने Lingrove द्वारा भेजे गए निर्देशित-जनरेशन अनुरोध को अस्वीकार कर दिया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence menolak permintaan pembuatan terpandu yang dikirim Lingrove."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ha rifiutato una richiesta di generazione guidata inviata da Lingrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple IntelligenceはLingroveが送信したガイド付き生成リクエストを拒否しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 Lingrove가 보낸 안내 생성 요청을 거부했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Intelligence recusou uma solicitação de geração guiada enviada pelo Lingrove."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence отклонила запрос Lingrove на управляемую генерацию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence, Lingrove'nin gönderdiği yönlendirilmiş oluşturma isteğini reddetti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 拒绝了拾语发送的引导生成请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 拒絕拾語傳送的引導式生成要求。"
          }
        }
      }
    },
    "Apple Intelligence returned a response Lingrove could not decode.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد Apple Intelligence استجابة تعذّر على Lingrove فك ترميزها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence hat eine Antwort zurückgegeben, die Lingrove nicht decodieren konnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence devolvió una respuesta que Lingrove no pudo descodificar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence a renvoyé une réponse que Lingrove n’a pas pu décoder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ने ऐसा जवाब दिया जिसे Lingrove डिकोड नहीं कर सका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence mengembalikan respons yang tidak dapat didekode Lingrove."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ha restituito una risposta che Lingrove non ha potuto decodificare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceが返した応答をLingroveは解析できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 Lingrove가 해석할 수 없는 응답을 반환했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Intelligence retornou uma resposta que o Lingrove não conseguiu decodificar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence вернула ответ, который Lingrove не смог декодировать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
