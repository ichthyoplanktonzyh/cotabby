    "Where Lingrove stays quiet": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حيث يلتزم Lingrove الصمت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo Lingrove still bleibt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde Lingrove permanece en silencio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où Lingrove ne fait aucune suggestion"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove कहाँ शांत रहता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat Lingrove tidak memberi saran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove Lingrove resta silenzioso"
          }
        },
        "ja": {
