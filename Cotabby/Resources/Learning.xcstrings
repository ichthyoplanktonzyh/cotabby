    "With this endpoint, this text is sent to the configured HTTPS remote service.": {
      "comment": "Privacy notice shown when the learning endpoint uses a public HTTPS host.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسل هذا النص إلى الخدمة البعيدة المضبوطة عبر HTTPS عند استخدام نقطة النهاية هذه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei diesem Endpunkt wird dieser Text an den konfigurierten externen HTTPS-Dienst gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con este endpoint, este texto se envía al servicio remoto HTTPS configurado."
          }
