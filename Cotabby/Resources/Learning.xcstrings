    "You can read or copy the expression. The source text will be checked again before replacement.": {
      "comment": "Explains that replacement is available and the source is revalidated after the user confirms.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك قراءة التعبير أو نسخه. سيُتحقق من النص المصدر مجددًا قبل استبداله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst den Ausdruck lesen oder kopieren. Vor dem Ersetzen wird der Ausgangstext erneut überprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes leer o copiar la expresión. El texto de origen se volverá a comprobar antes de reemplazarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez lire ou copier l’expression. Le texte source sera à nouveau vérifié avant le remplacement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अभिव्यक्ति पढ़ या कॉपी कर सकते हैं। बदलने से पहले स्रोत पाठ की दोबारा जाँच होगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat membaca atau menyalin ungkapan ini. Teks sumber akan diperiksa kembali sebelum diganti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi leggere o copiare l’espressione. Prima della sostituzione, il testo originale viene verificato di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表現を読んだりコピーしたりできます。置換前に原文を再確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표현을 읽거나 복사할 수 있습니다. 교체하기 전에 원문을 다시 확인합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ler ou copiar a expressão. O texto de origem será verificado novamente antes da substituição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете прочитать или скопировать выражение. Перед заменой исходный текст будет проверен ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İfadeyi okuyabilir veya kopyalayabilirsiniz. Değiştirmeden önce kaynak metin yeniden denetlenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以阅读或复制此表达。替换前会再次检查原文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以閱讀或複製這段譯文。取代文字前，系統會再次檢查原文。"
          }
        }
      }
    },
    "You can read or copy the expression. To replace text, select the source manually and preview it again.": {
      "comment": "Copy-only preview guidance when the editor does not support a safe automatic replacement.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك قراءة التعبير أو نسخه. لاستبدال النص، حدّد النص المصدر يدويًا وعاينه من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst den Ausdruck lesen oder kopieren. Um Text zu ersetzen, wähle den Ausgangstext manuell aus und zeige die Vorschau erneut an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes leer o copiar la expresión. Para reemplazar el texto, selecciona manualmente el texto de origen y vuelve a previsualizarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez lire ou copier l’expression. Pour remplacer le texte, sélectionnez la source manuellement et prévisualisez-la à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अभिव्यक्ति पढ़ या कॉपी कर सकते हैं। पाठ बदलने के लिए स्रोत मैन्युअल रूप से चुनें और फिर पूर्वावलोकन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat membaca atau menyalin ungkapan ini. Untuk mengganti teks, pilih sumber secara manual dan buat pratinjau lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi leggere o copiare l’espressione. Per sostituire il testo, seleziona manualmente il testo originale e visualizzalo di nuovo in anteprima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表現を読んだりコピーしたりできます。テキストを置換するには、原文を手動で選択してプレビューし直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표현을 읽거나 복사할 수 있습니다. 텍스트를 교체하려면 원문을 직접 선택하고 다시 미리 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ler ou copiar a expressão. Para substituir o texto, selecione a origem manualmente e gere a prévia novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете прочитать или скопировать выражение. Чтобы заменить текст, вручную выделите исходный текст и снова запустите предпросмотр."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İfadeyi okuyabilir veya kopyalayabilirsiniz. Metni değiştirmek için kaynak metni elle seçip yeniden önizleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以阅读或复制此表达。如需替换文本，请手动选择原文并重新预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以閱讀或複製這段譯文。若要取代文字，請手動選取原文後重新預覽。"
          }
        }
      }
    },
    "You can read or copy the result. This editor cannot confirm that writing is safe, so the preview is read-only.": {
      "comment": "Explains why a learning preview is read-only when editor or input-method state cannot be verified.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك قراءة النتيجة أو نسخها. لا يستطيع هذا المحرر تأكيد أن الكتابة آمنة، لذا تظل المعاينة للقراءة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das Ergebnis lesen oder kopieren. Dieser Editor kann nicht bestätigen, dass das Schreiben sicher ist; deshalb ist die Vorschau schreibgeschützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes leer o copiar el resultado. Este editor no puede confirmar que sea seguro escribir, así que la vista previa es de solo lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez lire ou copier le résultat. Cet éditeur ne peut pas confirmer que l’écriture est sûre ; l’aperçu est donc en lecture seule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप परिणाम पढ़ या कॉपी कर सकते हैं। यह संपादक सुरक्षित रूप से लिखे जाने की पुष्टि नहीं कर सकता, इसलिए पूर्वावलोकन केवल पढ़ने के लिए है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat membaca atau menyalin hasilnya. Editor ini tidak dapat memastikan bahwa penulisan aman, jadi pratinjau hanya dapat dibaca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi leggere o copiare il risultato. Questo editor non può confermare che la scrittura sia sicura, quindi l’anteprima è di sola lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果を読んだりコピーしたりできます。このエディタでは書き込みの安全性を確認できないため、プレビューは読み取り専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과를 읽거나 복사할 수 있습니다. 이 편집기는 쓰기가 안전한지 확인할 수 없으므로 미리보기는 읽기 전용입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ler ou copiar o resultado. Este editor não consegue confirmar se é seguro escrever, por isso a prévia é somente para leitura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете прочитать или скопировать результат. Этот редактор не позволяет подтвердить безопасность записи, поэтому предпросмотр доступен только для чтения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonucu okuyabilir veya kopyalayabilirsiniz. Bu düzenleyici güvenli biçimde yazılabileceğini doğrulayamadığından önizleme salt okunurdur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以阅读或复制结果。此编辑器无法确认写入是否安全，因此预览为只读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以閱讀或複製結果。此編輯器無法確認寫入是否安全，因此預覽僅供閱讀。"
          }
        }
      }
    },
    "You can still read the translation, compare it with the source, and look up words when phrase matching is off. Matching only identifies corresponding excerpts; it does not translate again or generate explanations.": {
      "comment": "Explains the independent phrase-matching setting and what its model does.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك قراءة الترجمة ومقارنتها بالنص المصدر والبحث عن الكلمات حتى عند إيقاف مطابقة العبارات. تقتصر المطابقة على تحديد المقاطع المتناظرة؛ فهي لا تعيد الترجمة ولا تُنشئ شروحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch bei deaktivierter Phrasenzuordnung kannst du die Übersetzung lesen, mit dem Ausgangstext vergleichen und Wörter nachschlagen. Die Zuordnung findet nur entsprechende Textabschnitte; sie übersetzt nicht erneut und erstellt keine Erklärungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aunque la correspondencia de frases esté desactivada, puedes leer la traducción, compararla con el texto de origen y consultar palabras. La correspondencia solo identifica fragmentos que se corresponden; no vuelve a traducir ni genera explicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez toujours lire la traduction, la comparer à la source et rechercher des mots lorsque la correspondance des expressions est désactivée. La correspondance identifie uniquement les extraits correspondants ; elle ne retraduit pas et ne génère pas d’explications."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वाक्यांश मिलान बंद होने पर भी आप अनुवाद पढ़ सकते हैं, उसकी तुलना स्रोत पाठ से कर सकते हैं और शब्द डिक्शनरी में देख सकते हैं। मिलान केवल एक-दूसरे से संबंधित पाठांशों की पहचान करता है; यह दोबारा अनुवाद या व्याख्या नहीं बनाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat pencocokan frasa nonaktif, Anda tetap dapat membaca terjemahan, membandingkannya dengan teks sumber, dan mencari kata. Pencocokan hanya menunjukkan cuplikan yang bersesuaian; fitur ini tidak menerjemahkan ulang atau membuat penjelasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi comunque leggere la traduzione, confrontarla con il testo originale e cercare le parole quando l’allineamento delle frasi è disattivato. L’allineamento identifica solo estratti corrispondenti: non traduce di nuovo e non genera spiegazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーズ照合がオフでも、翻訳を読んで原文と比べたり、単語を調べたりできます。照合では対応する抜粋を特定するだけで、再翻訳や解説の生成は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구문 대응이 꺼져 있어도 번역을 읽고 원문과 비교하며 단어를 찾아볼 수 있습니다. 이 기능은 원문과 번역에서 서로 대응하는 구간만 식별하며, 다시 번역하거나 설명을 생성하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo com a correspondência entre frases desativada, você ainda pode ler a tradução, compará-la com o texto de origem e consultar palavras. A correspondência apenas identifica trechos equivalentes; não traduz novamente nem gera explicações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже когда сопоставление фраз выключено, вы можете читать перевод, сравнивать его с исходным текстом и искать слова в словаре. Сопоставление лишь отмечает соответствующие фрагменты; оно не выполняет повторный перевод и не создаёт пояснений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İfade eşleştirme kapalıyken de çeviriyi okuyabilir, kaynak metinle karşılaştırabilir ve kelimeleri arayabilirsiniz. Eşleştirme yalnızca karşılık gelen metin parçalarını belirler; metni yeniden çevirmez veya açıklama üretmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭短语匹配后，你仍可阅读译文、与原文对照并查询单词。匹配功能只标出相互对应的文本片段；不会重新翻译，也不会生成解释。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使關閉片語對應，你仍可閱讀譯文、與原文比較並查詢單字。對應功能只會找出彼此對應的文字片段；不會再次翻譯，也不會生成解說。"
          }
        }
      }
    },
    "Your input method has uncommitted text. Confirm the candidate and finish composing before previewing; the original text was kept.": {
      "comment": "Guidance shown when the host input method still has marked text and the learning feature cannot safely capture it.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تثبّت طريقة الإدخال النص بعد. أكّد النص المقترح وأكمل إدخاله قبل المعاينة؛ أُبقي على النص الأصلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Eingabemethode enthält noch nicht bestätigten Text. Bestätige den Vorschlag und schließe die Eingabe ab, bevor du die Vorschau öffnest; der Originaltext blieb erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El método de entrada tiene texto sin confirmar. Confirma la composición y termina de escribir antes de previsualizar; se conservó el texto original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre méthode de saisie contient du texte non validé. Confirmez le candidat et terminez la composition avant l’aperçu ; le texte d’origine a été conservé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनपुट विधि में टेक्स्ट की पुष्टि अभी बाकी है। पूर्वावलोकन से पहले दिखाए गए विकल्प की पुष्टि करके टाइपिंग पूरी करें; मूल पाठ जस का तस रखा गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Metode input Anda masih memiliki teks yang belum dikonfirmasi. Konfirmasikan kandidat dan selesaikan proses komposisi sebelum membuat pratinjau; teks asli tetap dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il metodo di immissione contiene testo non confermato. Conferma il candidato e completa la composizione prima di visualizzare l’anteprima; il testo originale è stato mantenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
