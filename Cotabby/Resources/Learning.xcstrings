    "The model reached its output limit; the truncated result was not treated as a complete expression.": {
      "comment": "Error shown when generation reaches its token limit before a complete expression is returned.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغ النموذج حدّ الإخراج؛ ولم تُعامل النتيجة المبتورة كتعبير كامل."
