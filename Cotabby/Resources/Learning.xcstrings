        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "33 dil · Yazmaya ara verince cümleleri çevirmek için hafif varsayılan model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 33 种语言 · 轻量默认模型，适合在输入暂停后翻译句子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援 33 種語言 · 暫停輸入後翻譯句子的輕量預設選項。"
          }
        }
      }
    },
    "55 languages · Google's translation model, distributed as a text-only GGUF quantization by bullerwins.": {
      "comment": "Recommendation and provenance for the TranslateGemma GGUF model.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "55 لغة · نموذج ترجمة Google، يوزّعه bullerwins بصيغة GGUF نصية فقط ومكمّمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "55 Sprachen · Googles Übersetzungsmodell, das bullerwins als reine Text-GGUF-Quantisierung bereitstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "55 idiomas · Modelo de traducción de Google, distribuido por bullerwins como una cuantización GGUF solo de texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "55 langues · Modèle de traduction de Google, distribué sous forme de quantification GGUF texte uniquement par bullerwins."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "55 भाषाएँ · Google का अनुवाद मॉडल, जिसे bullerwins ने केवल-पाठ GGUF क्वांटाइज़ेशन के रूप में वितरित किया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "55 bahasa · Model terjemahan Google, didistribusikan sebagai GGUF yang dikuantisasi khusus untuk teks oleh bullerwins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "55 lingue · Modello di traduzione di Google, distribuito da bullerwins in formato GGUF quantizzato solo testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "55言語 · Googleの翻訳モデルを、bullerwinsがテキスト専用のGGUF量子化モデルとして配布しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "55개 언어 · bullerwins가 텍스트 전용 GGUF 양자화로 배포하는 Google 번역 모델입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "55 idiomas · Modelo de tradução do Google, distribuído por bullerwins como uma quantização GGUF somente de texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "55 языков · Модель перевода Google, выпущенная bullerwins в виде текстовой GGUF-квантизации."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "55 dil · Google'ın, bullerwins tarafından yalnızca metin içeren GGUF nicelemesi olarak dağıtılan çeviri modeli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 55 种语言 · Google 的翻译模型，由 bullerwins 以纯文本 GGUF 量化版本分发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援 55 種語言 · Google 的翻譯模型，由 bullerwins 發佈為純文字 GGUF 量化版本。"
          }
        }
      }
