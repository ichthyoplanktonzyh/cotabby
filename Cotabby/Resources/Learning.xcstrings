    "Choose a local GGUF or a separate endpoint for sentence translation. A translation-focused model is recommended.": {
      "comment": "Description of the translation task's engine setting.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نموذجًا محليًا بصيغة GGUF أو نقطة نهاية منفصلة لترجمة الجمل. يُوصى بنموذج مخصص للترجمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle für die Satzübersetzung ein lokales GGUF-Modell oder einen separaten Endpunkt aus. Ein auf Übersetzungen spezialisiertes Modell wird empfohlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un GGUF local o un endpoint independiente para traducir oraciones. Se recomienda un modelo especializado en traducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un GGUF local ou un endpoint distinct pour traduire les phrases. Un modèle spécialisé dans la traduction est recommandé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वाक्य के अनुवाद के लिए स्थानीय GGUF मॉडल या अलग एंडपॉइंट चुनें। अनुवाद के लिए विशेष रूप से बनाया गया मॉडल सुझाया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih model GGUF lokal atau endpoint terpisah untuk menerjemahkan kalimat. Disarankan menggunakan model khusus terjemahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un modello GGUF locale o un endpoint separato per tradurre le frasi. È consigliato un modello specializzato nella traduzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文の翻訳には、ローカルGGUFモデルまたは別のエンドポイントを選択してください。翻訳向けモデルをおすすめします。"
