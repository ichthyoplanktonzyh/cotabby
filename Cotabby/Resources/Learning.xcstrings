    "Show a small icon at the edge of a field when Lingrove is ready to suggest.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار أيقونة صغيرة عند حافة الحقل عندما يكون Lingrove جاهزًا للاقتراح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleines Symbol am Rand eines Feldes anzeigen, wenn Lingrove bereit für einen Vorschlag ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un icono pequeño en el borde de un campo cuando Lingrove esté listo para sugerir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une petite icône au bord d’un champ lorsque Lingrove est prêt à suggérer."
