            "state": "translated",
            "value": "Lingroveが静かにしている場所"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove가 조용히 있는 곳"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde o Lingrove fica em silêncio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где Lingrove не вмешивается"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove'nin sessiz kaldığı yer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
