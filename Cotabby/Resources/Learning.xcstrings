          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 傳回拾語無法解碼的回應。"
          }
        }
      }
    },
    "Apps where Lingrove never autocompletes.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
