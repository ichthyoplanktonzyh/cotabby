    "Expression highlights are unavailable; you can still double-click words to look them up.": {
      "comment": "Status when expression recognition failed but dictionary lookup remains available.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تمييز التعبيرات؛ لا يزال بإمكانك النقر نقرًا مزدوجًا على الكلمات للبحث عنها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hervorhebungen von Ausdrücken sind nicht verfügbar. Du kannst Wörter weiterhin per Doppelklick nachschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resaltado de expresiones no está disponible; aún puedes hacer doble clic en las palabras para consultarlas en el diccionario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les surlignages d’expression sont indisponibles ; vous pouvez tout de même double-cliquer sur des mots pour les rechercher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभिव्यक्ति के हाइलाइट उपलब्ध नहीं हैं; शब्दों को देखने के लिए अब भी डबल-क्लिक कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorotan ungkapan tidak tersedia; Anda tetap dapat mengeklik dua kali kata untuk mencarinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le evidenziazioni delle espressioni non sono disponibili; puoi comunque fare doppio clic sulle parole per cercarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表現のハイライトは利用できません。単語をダブルクリックして検索する機能は引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표현 강조 표시를 사용할 수 없습니다. 그래도 단어를 이중 클릭하여 찾아볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os destaques de expressões estão indisponíveis; ainda é possível dar um duplo clique nas palavras para consultá-las."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсветка выражений недоступна; слова по-прежнему можно искать двойным щелчком."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İfade vurguları kullanılamıyor; kelimeleri aramak için yine de çift tıklayabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法标出表达；仍可双击单词查询。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法顯示片語標示；你仍可連按兩下單字查詢。"
          }
        }
