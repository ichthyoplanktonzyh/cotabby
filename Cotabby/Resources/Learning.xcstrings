          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В выделенном фрагменте нет букв, которые можно перевести."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili aralıkta dönüştürülebilecek metin yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选范围中没有可转换的文本。"
