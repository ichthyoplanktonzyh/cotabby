            "value": "翻訳は生成されましたが、フレーズの対応箇所を利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역은 생성되었지만 구문 대응을 사용할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução foi gerada, mas as correspondências entre frases estão indisponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод готов, но сопоставление фраз недоступно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri oluşturuldu ancak ifade eşleşmeleri kullanılamıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "译文已生成，但短语匹配不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "譯文已產生，但無法使用片語對應。"
          }
        }
      }
    },
    "There is no complete sentence at the caret. Select text manually.": {
      "comment": "Guidance shown when the caret is not inside a complete sentence suitable for preview.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد جملة كاملة عند موضع الإدراج. حدّد النص يدويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An der Einfügemarke befindet sich kein vollständiger Satz. Wähle den Text manuell aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una oración completa en el punto de inserción. Selecciona el texto manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune phrase complète ne se trouve au niveau du curseur. Sélectionnez le texte manuellement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैरेट पर कोई पूरा वाक्य नहीं है। पाठ मैन्युअल रूप से चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada kalimat lengkap pada posisi kursor. Pilih teks secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cursore non si trova in una frase completa. Seleziona manualmente il testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャレット位置に完全な文がありません。テキストを手動で選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서 위치에 완전한 문장이 없습니다. 텍스트를 직접 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há uma frase completa no cursor. Selecione o texto manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каретки нет целого предложения. Выделите текст вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmlecin bulunduğu yerde eksiksiz bir cümle yok. Metni elle seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入点处没有完整句子。请手动选择文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "插入點所在位置沒有完整句子。請手動選取文字。"
          }
        }
      }
    },
    "This editor only provides text markers. Copy the current sentence translation, or select the source manually and preview it again.": {
      "comment": "Copy-only recovery guidance when the editor does not expose a safe text-selection replacement action.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوفّر هذا المحرر سوى علامات النص. انسخ ترجمة الجملة الحالية، أو حدّد النص المصدر يدويًا وعاينه مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Editor stellt nur Textmarkierungen bereit. Kopiere die Übersetzung des aktuellen Satzes oder wähle den Ausgangstext manuell aus und zeige die Vorschau erneut an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este editor solo proporciona marcadores de texto. Copia la traducción de la oración actual o selecciona manualmente el texto de origen y vuelve a previsualizarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet éditeur ne fournit que des marqueurs de texte. Copiez la traduction de la phrase actuelle, ou sélectionnez la source manuellement et prévisualisez-la à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह संपादक केवल टेक्स्ट मार्कर देता है। मौजूदा वाक्य का अनुवाद कॉपी करें, या स्रोत पाठ मैन्युअल रूप से चुनकर फिर पूर्वावलोकन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor ini hanya menyediakan penanda teks. Salin terjemahan kalimat saat ini, atau pilih teks sumber secara manual lalu buat pratinjau lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo editor fornisce solo marcatori di testo. Copia la traduzione della frase corrente oppure seleziona manualmente il testo originale e visualizzalo di nuovo in anteprima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエディタが提供するのはテキストマーカーだけです。現在の文の翻訳をコピーするか、原文を手動で選択してプレビューし直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 편집기는 텍스트 마커만 제공합니다. 현재 문장 번역을 복사하거나 원문을 직접 선택하고 다시 미리 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este editor só fornece marcadores de texto. Copie a tradução da frase atual ou selecione o texto de origem manualmente e gere a prévia novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот редактор предоставляет только маркеры текста. Скопируйте перевод текущего предложения или вручную выделите исходный текст и снова запустите предпросмотр."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu düzenleyici yalnızca metin işaretçileri sağlar. Geçerli cümlenin çevirisini kopyalayın veya kaynak metni elle seçip yeniden önizleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此编辑器仅提供文本标记。请复制当前句子的译文，或手动选择原文并重新预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此編輯器只提供文字標記。請複製目前句子的譯文，或手動選取原文後重新預覽。"
          }
        }
      }
    },
    "This field does not support safe selection replacement. Copy and paste the translation manually; the original text was kept.": {
      "comment": "Recovery guidance when the host field does not allow safe replacement of the selected source.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدعم هذا الحقل استبدال النص المحدد بأمان. انسخ الترجمة والصقها يدويًا؛ أُبقي على النص الأصلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Feld kann die Auswahl nicht sicher ersetzt werden. Kopiere die Übersetzung und füge sie manuell ein; der Originaltext blieb erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este campo no permite reemplazar la selección de forma segura. Copia y pega la traducción manualmente; se conservó el texto original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce champ ne prend pas en charge le remplacement sécurisé d’une sélection. Copiez-collez la traduction manuellement ; le texte d’origine a été conservé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ील्ड में चुना हुआ पाठ सुरक्षित रूप से बदला नहीं जा सकता। अनुवाद मैन्युअल रूप से कॉपी और पेस्ट करें; मूल पाठ जस का तस रखा गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bidang ini tidak mendukung penggantian pilihan yang aman. Salin dan tempel terjemahan secara manual; teks asli tetap dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo campo non consente di sostituire la selezione in modo sicuro. Copia e incolla manualmente la traduzione; il testo originale è stato mantenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフィールドでは選択範囲を安全に置換できません。原文はそのまま残っています。翻訳を手動でコピーして貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 필드는 안전한 선택 영역 교체를 지원하지 않습니다. 번역을 수동으로 복사하여 붙여넣으세요. 원문은 유지되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este campo não permite substituir a seleção com segurança. Copie e cole a tradução manualmente; o texto original foi mantido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом поле нельзя безопасно заменить выделенный текст. Скопируйте и вставьте перевод вручную; исходный текст сохранён."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alan güvenli biçimde seçilen metni değiştirmeyi desteklemiyor. Çeviriyi elle kopyalayıp yapıştırın; özgün metin korundu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此输入框不支持安全地替换选区。请手动复制并粘贴译文；原文已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此欄位不支援安全地取代選取文字。請手動複製並貼上譯文；原文仍保留。"
          }
        }
      }
    },
    "This field or selection cannot be verified. Select the committed source text again; the original text was kept.": {
      "comment": "Error shown when Accessibility cannot verify the field, selection, or committed source text for a translation preview.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من هذا الحقل أو التحديد. حدّد النص المصدر المثبّت من جديد؛ أُبقي على النص الأصلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Feld oder die Auswahl kann nicht überprüft werden. Wähle den bestätigten Ausgangstext erneut aus; der Originaltext blieb erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede verificar este campo o la selección. Vuelve a seleccionar el texto de origen confirmado; se conservó el texto original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce champ ou cette sélection ne peut pas être vérifié. Sélectionnez à nouveau le texte source validé ; le texte d’origine a été conservé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ील्ड या चयन की पुष्टि नहीं हो सकी। पूरी तरह दर्ज स्रोत पाठ फिर से चुनें; मूल पाठ जस का तस रखा गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bidang atau pilihan ini tidak dapat diverifikasi. Pilih kembali teks sumber yang sudah dikonfirmasi; teks asli tetap dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare questo campo o la selezione. Seleziona di nuovo il testo originale confermato; il testo originale è stato mantenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフィールドまたは選択範囲を確認できません。確定済みの原文を選択し直してください。元のテキストはそのまま残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 필드 또는 선택 영역을 확인할 수 없습니다. 확정된 원문을 다시 선택하세요. 원문은 유지되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar este campo ou a seleção. Selecione novamente o texto de origem confirmado; o texto original foi mantido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить это поле или выделение. Ещё раз выделите подтверждённый исходный текст; исходный текст сохранён."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alan veya seçim doğrulanamıyor. Girişi tamamlanmış kaynak metni yeniden seçin; özgün metin korundu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证此输入框或选区。请重新选择已确认输入的原文；原文已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認此欄位或選取範圍。請重新選取已確認輸入的原文；原文仍保留。"
          }
        }
      }
    },
    "This file is used by autocomplete, translation, chunk alignment, or a power profile.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم هذا الملف للإكمال التلقائي أو الترجمة أو محاذاة المقاطع أو لملف تعريف طاقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei wird für die automatische Vervollständigung, Übersetzung, Textabschnittszuordnung oder ein Energieprofil verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo se usa para el autocompletado, la traducción, la alineación de fragmentos o un perfil de alimentación."
