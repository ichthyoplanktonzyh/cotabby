    "Chunk alignment is off; dictionary lookup is still available.": {
      "comment": "Status shown when chunk alignment is disabled while the translation remains available.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطابقة العبارات متوقفة؛ ولا يزال البحث في القاموس متاحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Phrasenzuordnung ist deaktiviert; das Nachschlagen im Wörterbuch ist weiterhin möglich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La correspondencia de frases está desactivada; el diccionario sigue disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La correspondance des expressions est désactivée ; la recherche dans le dictionnaire reste disponible."
          }
        },
