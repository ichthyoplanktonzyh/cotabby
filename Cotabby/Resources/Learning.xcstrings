          "stringUnit": {
            "state": "translated",
            "value": "Envoltorio Swift de llama.cpp que expone la API de inferencia con la que enlaza Lingrove."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enveloppe Swift autour de llama.cpp qui expose l’API d’inférence utilisée par Lingrove."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "llama.cpp के चारों ओर Swift रैपर जो Lingrove द्वारा लिंक किए गए अनुमान API को उपलब्ध कराता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrapper Swift di sekitar llama.cpp yang mengekspos API inferensi yang ditautkan Lingrove."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libreria Swift che avvolge llama.cpp ed espone l’API di inferenza usata da Lingrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingroveがリンクする推論APIを公開するllama.cppのSwiftラッパー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove가 연결하는 추론 API를 제공하는 llama.cpp용 Swift 래퍼."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrapper Swift em torno do llama.cpp que expõe a API de inferência à qual o Lingrove se vincula."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обёртка на Swift для llama.cpp, предоставляющая API инференса, используемый Lingrove."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove'nin bağlandığı çıkarım API'sini sunan llama.cpp etrafında Swift sarmalayıcısı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
