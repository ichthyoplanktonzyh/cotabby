    "GGUF metadata is incomplete or exceeds the supported read limit.": {
      "comment": "Error shown when GGUF metadata is missing or larger than the parser's safe limit.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات GGUF الوصفية غير مكتملة أو تتجاوز حد القراءة المسموح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die GGUF-Metadaten sind unvollständig oder überschreiten die unterstützte Lesegrenze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los metadatos GGUF están incompletos o superan el límite de lectura admitido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les métadonnées GGUF sont incomplètes ou dépassent la limite de lecture prise en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF मेटाडेटा अधूरा है या पढ़ने की समर्थित सीमा से बड़ा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata GGUF tidak lengkap atau melebihi batas baca yang didukung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I metadati GGUF sono incompleti o superano il limite di lettura supportato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUFメタデータが不完全か、読み取り上限を超えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF 메타데이터가 불완전하거나 지원되는 읽기 한도를 초과했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os metadados GGUF estão incompletos ou excedem o limite de leitura aceito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
