            "state": "translated",
            "value": "Lingrove 일시 중지됨"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove pausado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove приостановлен"
          }
        },
        "tr": {
          "stringUnit": {
