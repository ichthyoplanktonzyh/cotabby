    "The local expression dictionary could not be read. You can still look up individual words.": {
      "comment": "Error shown when the bundled expression dictionary cannot be read or decoded.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة قاموس التعبيرات المحلي. لا يزال بإمكانك البحث عن الكلمات المفردة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lokale Ausdruckswörterbuch konnte nicht gelesen werden. Einzelne Wörter kannst du weiterhin nachschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el diccionario local de expresiones. Aún puedes consultar palabras sueltas."
          }
        },
        "fr": {
