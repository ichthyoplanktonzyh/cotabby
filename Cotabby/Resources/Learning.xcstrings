    "33 languages · Larger translation model that requires more memory.": {
      "comment": "Recommendation shown for the 7B Hy-MT2 translation model.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "33 لغة · نموذج ترجمة أكبر يتطلب ذاكرة أكثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "33 Sprachen · Größeres Übersetzungsmodell mit höherem Arbeitsspeicherbedarf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "33 idiomas · Modelo de traducción más grande que requiere más memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "33 langues · Modèle de traduction plus grand nécessitant davantage de mémoire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "33 भाषाएँ · अधिक मेमोरी लेने वाला बड़ा अनुवाद मॉडल।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "33 bahasa · Model terjemahan yang lebih besar dan membutuhkan lebih banyak memori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "33 lingue · Modello di traduzione più grande, che richiede più memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "33言語 · より多くのメモリが必要な大型翻訳モデル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "33개 언어 · 더 많은 메모리가 필요한 대형 번역 모델입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "33 idiomas · Modelo de tradução maior, que requer mais memória."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "33 языка · Более крупная модель перевода, которой требуется больше памяти."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "33 dil · Daha fazla bellek gerektiren büyük çeviri modeli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 33 种语言 · 翻译质量更高，但需要更多内存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援 33 種語言 · 較大型的翻譯模型，需要更多記憶體。"
          }
        }
      }
    },
    "33 languages · Lightweight default for translating sentences after a pause.": {
      "comment": "Recommendation shown for the small Hy-MT2 translation model.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
