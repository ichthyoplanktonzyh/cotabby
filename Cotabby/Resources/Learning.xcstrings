    "The local model could not be loaded. Confirm that this GGUF architecture is supported by the inference runtime.": {
      "comment": "Error shown when the selected local GGUF model fails to load.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل النموذج المحلي. تحقّق من أن بنية GGUF مدعومة في بيئة الاستدلال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lokale Modell konnte nicht geladen werden. Prüfe, ob die Inferenz-Laufzeit diese GGUF-Architektur unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el modelo local. Comprueba que el motor de inferencia admita esta arquitectura GGUF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle local n’a pas pu être chargé. Vérifiez que cette architecture GGUF est prise en charge par le runtime d’inférence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय मॉडल लोड नहीं हो सका। पुष्टि करें कि यह GGUF आर्किटेक्चर इन्फ़रेंस रनटाइम में समर्थित है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model lokal tidak dapat dimuat. Pastikan arsitektur GGUF ini didukung oleh runtime inferensi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare il modello locale. Verifica che il runtime di inferenza supporti questa architettura GGUF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
