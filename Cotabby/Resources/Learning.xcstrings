    "The model returned empty, oversized, or unsafe-to-insert text. The original text was kept.": {
      "comment": "Error shown when generated text fails validation and is not inserted into the editor.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد النموذج نصًا فارغًا أو كبيرًا جدًا أو غير آمن للإدراج. أُبقي على النص الأصلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell hat leeren, zu langen oder nicht sicher einfügbaren Text zurückgegeben. Der Originaltext blieb erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo devolvió texto vacío, demasiado largo o no apto para insertarse de forma segura. Se conservó el texto original."
          }
        },
        "fr": {
          "stringUnit": {
