    "No %@ requests recorded yet. Use that feature to populate this list.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد طلبات %@ مسجّلة بعد. استخدم تلك الميزة لملء هذه القائمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Anfragen für %@ aufgezeichnet. Verwende die Funktion, um diese Liste zu füllen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay solicitudes de %@ registradas todavía. Usa esa función para añadir solicitudes a esta lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune requête %@ enregistrée pour le moment. Utilisez cette fonctionnalité pour remplir cette liste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक %@ के कोई अनुरोध रिकॉर्ड नहीं हुए। यह सूची भरने के लिए उस सुविधा का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada permintaan %@ yang tercatat. Gunakan fitur tersebut untuk mengisi daftar ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna richiesta di %@ registrata. Usa questa funzione per popolare l’elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のリクエストはまだ記録されていません。この機能を使うとリストに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 요청이 아직 기록되지 않았습니다. 이 기능을 사용하여 목록을 채우세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma solicitação de %@ foi registrada ainda. Use esse recurso para preencher esta lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы для функции «%@» ещё не записывались. Используйте эту функцию, чтобы заполнить список."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz %@ isteği kaydedilmedi. Bu listeyi doldurmak için ilgili özelliği kullanın."
          }
        },
