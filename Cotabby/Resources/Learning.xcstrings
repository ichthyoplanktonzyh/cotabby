        }
      }
    },
    "The selected range exceeds 6 KB. Select shorter text manually; the source was not truncated.": {
      "comment": "Error shown when the selected text exceeds the safe request limit; no shortened text was sent.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاوز النص المحدد 6 كيلوبايت. حدّد نصًا أقصر يدويًا؛ لم يُقتطع النص المصدر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Passage ist größer als 6 KB. Wähle manuell einen kürzeren Text aus; der Ausgangstext wurde nicht gekürzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rango seleccionado supera los 6 KB. Selecciona manualmente un texto más corto; no se truncó el texto de origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plage sélectionnée dépasse 6 Ko. Sélectionnez manuellement un texte plus court ; la source n’a pas été tronquée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुना हुआ पाठ 6 KB से बड़ा है। छोटा पाठ मैन्युअल रूप से चुनें; स्रोत को काटा नहीं गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentang yang dipilih melebihi 6 KB. Pilih teks yang lebih pendek secara manual; sumber tidak dipotong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La selezione supera i 6 KB. Seleziona manualmente un testo più breve; il testo originale non è stato troncato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択範囲が6 KBを超えています。短い範囲を手動で選択してください。原文は切り詰められていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 범위가 6KB를 초과합니다. 더 짧은 텍스트를 직접 선택하세요. 원문은 잘리지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O trecho selecionado excede 6 KB. Selecione manualmente um texto mais curto; o texto de origem não foi truncado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделенный диапазон превышает 6 КБ. Выделите вручную более короткий текст; исходный текст не усекался."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili aralık 6 KB sınırını aşıyor. Daha kısa bir metni elle seçin; kaynak metin kısaltılmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选范围超过 6 KB。请手动选择较短的文本；原文未被截断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選範圍超過 6 KB。請手動選取較短的文字；原文不會遭截短。"
          }
        }
      }
    },
    "The selected text does not match the field range; the original text was kept.": {
      "comment": "Error shown when the selected text differs from the verified range in the editor.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتطابق النص المحدد مع نطاق الحقل؛ أُبقي على النص الأصلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ausgewählte Text stimmt nicht mit dem Textbereich im Feld überein; der Originaltext blieb erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto seleccionado no coincide con el rango del campo; se conservó el texto original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte sélectionné ne correspond pas à la plage du champ ; le texte d’origine a été conservé."
          }
        },
        "hi": {
