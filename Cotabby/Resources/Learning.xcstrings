    "Restart Lingrove to apply the selected interface language.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تشغيل Lingrove لتطبيق لغة الواجهة المحددة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte Lingrove neu, um die ausgewählte Sprache der Benutzeroberfläche anzuwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia Lingrove para aplicar el idioma de la interfaz seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrez Lingrove pour appliquer la langue d’interface choisie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनी गई इंटरफ़ेस भाषा लागू करने के लिए Lingrove को फिर से शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai ulang Lingrove untuk menerapkan bahasa antarmuka yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvia Lingrove per applicare la lingua dell’interfaccia selezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したインターフェイス言語を適用するには、Lingroveを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 인터페이스 언어를 적용하려면 Lingrove를 재시동하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicie o Lingrove para aplicar o idioma da interface selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустите Lingrove, чтобы применить выбранный язык интерфейса."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen arayüz dilini uygulamak için Lingrove'yi yeniden başlatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启拾语以应用所选界面语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動拾語以套用所選介面語言。"
          }
        }
      }
    },
    "Restore every Lingrove setting to its original default.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة كل إعدادات Lingrove إلى قيمتها الافتراضية الأصلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Lingrove-Einstellungen auf ihren ursprünglichen Standard zurücksetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura todos los ajustes de Lingrove a sus valores predeterminados originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir chaque réglage de Lingrove à sa valeur par défaut d’origine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove की हर सेटिंग को उसके मूल डिफ़ॉल्ट पर पुनर्स्थापित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan semua pengaturan Lingrove ke nilai bawaan semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina ogni impostazione di Lingrove al valore predefinito originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingroveのすべての設定を元のデフォルトに戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 Lingrove 설정을 원래 기본값으로 복원합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar todos os ajustes do Lingrove para o padrão original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить исходные значения всех настроек Lingrove."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her Lingrove ayarını ilk varsayılanına geri yükleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将拾语的所有设置恢复为原始默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所有拾語設定還原為原始預設值。"
          }
        }
      }
    },
    "Restore every Lingrove setting to its original default. This does not change macOS permissions, your Open at Login choice, or your accepted-word count.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة كل إعدادات Lingrove إلى قيمتها الافتراضية الأصلية. لا يغيّر ذلك أذونات macOS أو اختيارك للفتح عند تسجيل الدخول أو عدد الكلمات المقبولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Lingrove-Einstellungen auf ihren ursprünglichen Standard zurücksetzen. Dies ändert weder macOS-Berechtigungen noch deine Einstellung für „Beim Anmelden öffnen“ oder die Anzahl deiner übernommenen Wörter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura todos los ajustes de Lingrove a sus valores predeterminados originales. Esto no cambia los permisos de macOS, la opción Abrir al iniciar sesión ni el recuento de palabras aceptadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir chaque réglage de Lingrove à sa valeur par défaut d’origine. Cela ne modifie pas les autorisations macOS, le réglage d’ouverture de Lingrove à l’ouverture de session ni votre compteur de mots acceptés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove की हर सेटिंग को उसके मूल डिफ़ॉल्ट पर पुनर्स्थापित करें। इससे macOS अनुमतियाँ, आपकी Open at Login पसंद या स्वीकार किए गए शब्दों की गिनती नहीं बदलती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan semua pengaturan Lingrove ke nilai bawaan semula. Ini tidak mengubah izin macOS, pilihan Buka saat Login, atau jumlah kata yang diterima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina ogni impostazione di Lingrove al valore predefinito originale. Questa operazione non modifica le autorizzazioni di macOS, l’impostazione “Apri al login” o il conteggio delle parole accettate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingroveのすべての設定を元のデフォルトに戻します。macOSの権限、ログイン時に開く設定、挿入した単語数は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 Lingrove 설정을 원래 기본값으로 복원합니다. macOS 권한, 로그인 시 열기 선택 또는 수락한 단어 수는 변경되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar todos os ajustes do Lingrove para o padrão original. Isso não altera as permissões do macOS, sua escolha de abrir ao iniciar sessão nem sua contagem de palavras aceitas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить исходные значения всех настроек Lingrove. Это не изменит разрешения macOS, выбор «Открывать при входе» и счётчик принятых слов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her Lingrove ayarını ilk varsayılanına geri yükleyin. Bu işlem macOS izinlerini, Girişte Aç seçiminizi veya kabul edilen kelime sayınızı değiştirmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将拾语的所有设置恢复为原始默认值。不会更改 macOS 权限、“登录时打开”选择或已插入单词数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所有拾語設定還原為原始預設值。這不會變更 macOS 權限、「登入時開啟」選擇或已接受的單字計數。"
          }
        }
      }
    },
    "Returning users keep every setting they've already tuned. New users start from Lingrove's lean defaults and fine-tune length, model, and behavior in Settings.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ المستخدمون العائدون بكل إعداد سبق ضبطه. يبدأ المستخدمون الجدد من إعدادات Lingrove الخفيفة الافتراضية ويضبطون الطول والنموذج والسلوك في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederkehrende Benutzer behalten alle bereits angepassten Einstellungen. Neue Benutzer beginnen mit Lingroves schlanken Standardwerten und passen Länge, Modell und Verhalten in den Einstellungen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los usuarios que vuelven conservan todos los ajustes que ya han configurado. Los nuevos usuarios empiezan con los valores predeterminados básicos de Lingrove y ajustan la longitud, el modelo y el comportamiento en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les utilisateurs qui reviennent conservent tous les réglages déjà personnalisés. Les nouveaux utilisateurs commencent avec les valeurs par défaut allégées de Lingrove et ajustent la longueur, le modèle et le comportement dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वापस आने वाले उपयोगकर्ताओं की पहले से बदली गई सभी सेटिंग्ज़ बनी रहती हैं। नए उपयोगकर्ता Lingrove के सरल डिफ़ॉल्ट से शुरू करके सेटिंग्ज़ में लंबाई, मॉडल और व्यवहार को समायोजित कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengguna lama mempertahankan semua pengaturan yang telah disesuaikan. Pengguna baru memulai dari default Lingrove yang ringkas lalu menyesuaikan panjang, model, dan perilaku di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi torna a usare Lingrove mantiene tutte le impostazioni già personalizzate. I nuovi utenti partono dalle impostazioni essenziali di Lingrove e possono regolare lunghezza, modello e comportamento nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存ユーザーは調整済みの設定をすべて保持します。新規ユーザーはLingroveの軽量なデフォルトから始め、設定で長さ、モデル、動作を細かく調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 사용자는 이미 조정한 모든 설정을 유지합니다. 새 사용자는 Lingrove의 간결한 기본값으로 시작하고 설정에서 길이, 모델 및 동작을 조정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuários que retornam mantêm todos os ajustes que já personalizaram. Novos usuários começam com os padrões enxutos do Lingrove e ajustam comprimento, modelo e comportamento em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернувшиеся пользователи сохраняют все уже настроенные параметры. Новые пользователи начинают с лаконичных значений Lingrove по умолчанию и настраивают длину, модель и поведение в параметрах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri dönen kullanıcılar daha önce ayarladıkları tüm ayarları korur. Yeni kullanıcılar Lingrove'nin yalın varsayılanlarıyla başlar ve Ayarlar'da uzunluğu, modeli ve davranışı ince ayarlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回访用户保留已调整的所有设置。新用户从拾语的精简默认值开始，然后在设置中微调长度、模型和行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回訪使用者會保留已調整的所有設定。新使用者會從拾語的精簡預設值開始，並在「設定」中微調長度、模型與行為。"
          }
        }
      }
    },
