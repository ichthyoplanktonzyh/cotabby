    "Start Lingrove automatically when you log in to your Mac.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء Lingrove تلقائيًا عند تسجيل الدخول إلى جهاز Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove automatisch starten, wenn du dich an deinem Mac anmeldest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia Lingrove automáticamente cuando inicies sesión en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer Lingrove automatiquement à l’ouverture de session sur votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Mac में लॉगिन करने पर Lingrove अपने आप शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai Lingrove otomatis saat Anda login ke Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia Lingrove automaticamente quando accedi al Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacにログインしたときLingroveを自動的に起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 로그인할 때 Lingrove를 자동으로 시작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar o Lingrove automaticamente quando você iniciar sessão no Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускать Lingrove автоматически при входе в систему на Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inize giriş yaptığınızda Lingrove'yi otomatik olarak başlatın."
          }
