    "No per-app shortcuts. Lingrove uses the global accept key everywhere.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد اختصارات لكل تطبيق. يستخدم Lingrove مفتاح القبول العام في كل مكان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine App-spezifischen Kurzbefehle. Lingrove verwendet überall die globale Übernahmetaste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay atajos por app. Lingrove usa la tecla de aceptación global en todas partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun raccourci par app. Lingrove utilise partout la touche d’acceptation globale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप-विशिष्ट शॉर्टकट नहीं हैं। Lingrove हर जगह वैश्विक स्वीकार कुंजी का उपयोग करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pintasan per app. Lingrove menggunakan tombol penerimaan global di mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna scorciatoia specifica per app. Lingrove usa ovunque il tasto globale di accettazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリごとのショートカットはありません。Lingroveはどこでもグローバルの候補挿入キーを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱별 단축키가 없습니다. Lingrove는 어디서나 전역 수락 키를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum atalho por app. O Lingrove usa a tecla de aceitação global em todos os lugares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетаний для отдельных приложений нет. Lingrove использует глобальную клавишу принятия везде."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama başına kısayol yok. Lingrove her yerde genel kabul tuşunu kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有按 App 设置的快捷键。拾语在所有位置使用同一个全局建议插入快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有 App 專屬快速鍵。拾語在所有地方都使用全域接受按鍵。"
          }
        }
      }
    },
