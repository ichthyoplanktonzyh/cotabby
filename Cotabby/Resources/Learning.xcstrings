    "The editor refused the replacement. Check the source text; you can copy the translation or restore the original.": {
      "comment": "Recovery guidance when the editor rejects a confirmed selection replacement.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض المحرر الاستبدال. تحقّق من النص المصدر؛ يمكنك نسخ الترجمة أو استعادة النص الأصلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Editor hat das Ersetzen abgelehnt. Prüfe den Ausgangstext. Du kannst die Übersetzung kopieren oder den Originaltext wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El editor rechazó el reemplazo. Comprueba el texto de origen; puedes copiar la traducción o restaurar el original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’éditeur a refusé le remplacement. Vérifiez le texte source ; vous pouvez copier la traduction ou rétablir l’original."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपादक ने पाठ बदलने से इनकार कर दिया। स्रोत पाठ जाँचें; आप अनुवाद कॉपी कर सकते हैं या मूल पाठ वापस ला सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor menolak penggantian. Periksa teks sumber; Anda dapat menyalin terjemahan atau memulihkan teks asli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’editor ha rifiutato la sostituzione. Controlla il testo originale; puoi copiare la traduzione o ripristinare il testo originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタが置換を拒否しました。原文を確認してください。翻訳をコピーするか、原文を復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집기에서 교체를 거부했습니다. 원문을 확인하세요. 번역을 복사하거나 원문을 복원할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor recusou a substituição. Confira o texto de origem; você pode copiar a tradução ou restaurar o original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактор отказался заменять текст. Проверьте исходный текст; можно скопировать перевод или восстановить оригинал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenleyici değiştirmeyi reddetti. Kaynak metni kontrol edin; çeviriyi kopyalayabilir veya özgün metni geri yükleyebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑器拒绝了替换操作。请检查原文；你可以复制译文或还原原文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯器拒絕取代文字。請檢查原文；你可以複製譯文，或還原原文。"
          }
        }
      }
    },
