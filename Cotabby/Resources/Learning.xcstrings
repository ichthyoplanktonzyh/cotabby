          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Satz konnte nicht kodiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo codificar la oración actual."
