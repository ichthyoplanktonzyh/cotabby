    "Double-click a word to open Dictionary · closes as you type": {
      "comment": "Hint for the legacy detail card; dictionary lookup opens the macOS Dictionary panel.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر نقرًا مزدوجًا على كلمة لفتح «القاموس» · يُغلق عند بدء الكتابة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelklicke auf ein Wort, um es im Wörterbuch nachzuschlagen · schließt sich beim Tippen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic en una palabra para abrir el Diccionario · se cierra al escribir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-cliquez sur un mot pour ouvrir le Dictionnaire · se ferme pendant la saisie"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शब्द को डिक्शनरी में देखने के लिए डबल-क्लिक करें · टाइप करते ही बंद हो जाता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik dua kali kata untuk membuka Kamus · panel menutup saat Anda mengetik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai doppio clic su una parola per aprirla nel Dizionario · si chiude mentre scrivi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語をダブルクリックすると「辞書」が開きます · 入力すると閉じます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어를 이중 클릭하여 사전 열기 · 입력하면 닫힘"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê um duplo clique em uma palavra para abrir o Dicionário · fecha enquanto você digita"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды щёлкните слово, чтобы открыть приложение «Словарь» · закрывается при вводе"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözlük'te açmak için bir kelimeye çift tıklayın · yazmaya başlayınca kapanır"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击单词可打开“词典”查询 · 输入时关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連按兩下單字以開啟「字典」· 輸入時會關閉"
          }
        }
      }
    },
    "Double-click an expression to look it up · browse its words in Dictionary": {
      "comment": "Tooltip for translated sentence text; complete expressions and their words can be looked up.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر نقرًا مزدوجًا على تعبير للبحث عنه · استعرض كلماته في «القاموس»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelklicke auf einen Ausdruck, um ihn nachzuschlagen · schlage einzelne Wörter im Wörterbuch nach"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic en una expresión para consultarla · explora sus palabras en el Diccionario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-cliquez sur une expression pour la rechercher · parcourez ses mots dans le Dictionnaire"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभिव्यक्ति को डिक्शनरी में देखने के लिए डबल-क्लिक करें · उसके शब्द भी देख सकते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik dua kali ungkapan untuk mencarinya · telusuri kata-katanya di Kamus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai doppio clic su un’espressione per cercarla · consulta le singole parole nel Dizionario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表現をダブルクリックして検索 · 構成語を「辞書」で調べる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표현을 이중 클릭하여 검색 · 사전에서 단어 찾아보기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê um duplo clique em uma expressão para consultá-la · explore as palavras no Dicionário"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды щёлкните выражение, чтобы найти его · отдельные слова можно искать в приложении «Словарь»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ifadeyi aramak için çift tıklayın · kelimelerine Sözlük'te göz atın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击表达可查询 · 在“词典”中查看其中的单词"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連按兩下即可查詢片語 · 也可在「字典」中查詢其中的單字"
          }
        }
      }
    },
    "Durations are shown separately for each task. The shared history retains up to 100 requests across all tasks.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعرض مدة كل مهمة على حدة. ويحتفظ السجل المشترك بما يصل إلى 100 طلب من جميع المهام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dauer wird für jede Aufgabe separat angezeigt. Im gemeinsamen Verlauf bleiben bis zu 100 Anfragen aus allen Aufgaben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las duraciones se muestran por separado para cada tarea. El historial compartido conserva hasta 100 solicitudes de todas las tareas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les durées sont affichées séparément pour chaque tâche. L’historique partagé conserve jusqu’à 100 requêtes pour toutes les tâches."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर कार्य की अवधि अलग दिखाई जाती है। साझा इतिहास में सभी कार्यों के कुल अधिकतम 100 अनुरोध रखे जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Durasi ditampilkan terpisah untuk setiap tugas. Riwayat bersama menyimpan hingga 100 permintaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le durate sono mostrate separatamente per ogni attività. La cronologia condivisa conserva fino a 100 richieste per tutte le attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理時間はタスクごとに表示されます。共有履歴には全タスクのリクエストが最大100件保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 작업의 지속 시간은 별도로 표시됩니다. 공유 기록에는 모든 작업에서 최대 100개의 요청이 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As durações são exibidas separadamente por tarefa. O histórico compartilhado mantém até 100 solicitações entre todas as tarefas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длительность показывается отдельно для каждой задачи. Общая история хранит до 100 запросов для всех задач."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süreler her görev için ayrı gösterilir. Ortak geçmiş, tüm görevlerde toplam 100 isteğe kadar saklar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每项任务的耗时会分别显示。所有任务共用一份历史记录，最多保留 100 个请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各項工作的耗時會分開顯示。共用記錄最多保留所有工作合計 100 筆要求。"
          }
        }
      }
    },
