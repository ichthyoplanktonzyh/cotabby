    "Could not detect this GGUF's instruction template automatically. Choose one in Model settings.": {
      "comment": "Guidance shown when automatic instruction-template detection fails for a local GGUF model.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر اكتشاف قالب التعليمات لهذا الملف بصيغة GGUF تلقائيًا. اختر قالبًا من إعدادات النموذج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anweisungsvorlage dieses GGUF-Modells konnte nicht automatisch erkannt werden. Wähle unter „Modell“ eine Vorlage aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo detectar automáticamente la plantilla de instrucciones de este GGUF. Elige una en los ajustes del modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de détecter automatiquement le format de conversation de ce GGUF. Choisissez-en un dans Réglages du modèle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस GGUF का निर्देश टेम्पलेट अपने आप पहचाना नहीं जा सका। मॉडल सेटिंग्ज़ में कोई एक चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Template instruksi untuk GGUF ini tidak dapat dideteksi otomatis. Pilih salah satu di pengaturan Model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile rilevare automaticamente il template di istruzioni di questo GGUF. Scegline uno nelle impostazioni del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このGGUFの指示テンプレートを自動判定できませんでした。モデル設定で選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 GGUF의 지침 템플릿을 자동으로 감지할 수 없습니다. 모델 설정에서 하나를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível detectar automaticamente o formato de instrução deste GGUF. Escolha um nas configurações do modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось автоматически определить шаблон инструкций этой модели GGUF. Выберите его в настройках модели."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu GGUF'nin talimat şablonu otomatik olarak algılanamadı. Model ayarlarından bir şablon seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法自动识别此 GGUF 的指令模板。请在模型设置中选择模板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法自動偵測此 GGUF 的指令範本。請在模型設定中選擇範本。"
          }
        }
      }
    },
    "Could not safely select the current sentence. Copy the translation or select the source manually.": {
      "comment": "Recovery guidance when the current sentence cannot be selected safely for replacement.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديد الجملة الحالية بأمان. انسخ الترجمة أو حدّد النص المصدر يدويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Satz konnte nicht sicher ausgewählt werden. Kopiere die Übersetzung oder wähle den Ausgangstext manuell aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo seleccionar la oración actual de forma segura. Copia la traducción o selecciona el texto de origen manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de sélectionner la phrase actuelle en toute sécurité. Copiez la traduction ou sélectionnez manuellement la source."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा वाक्य को सुरक्षित रूप से चुना नहीं जा सका। अनुवाद कॉपी करें या स्रोत पाठ मैन्युअल रूप से चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalimat saat ini tidak dapat dipilih dengan aman. Salin terjemahan atau pilih teks sumber secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile selezionare in modo sicuro la frase corrente. Copia la traduzione oppure seleziona manualmente il testo originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の文を安全に選択できませんでした。翻訳をコピーするか、原文を手動で選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 문장을 안전하게 선택할 수 없습니다. 번역을 복사하거나 원문을 직접 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível selecionar a frase atual com segurança. Copie a tradução ou selecione o texto de origem manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось безопасно выделить текущее предложение. Скопируйте перевод или выделите исходный текст вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli cümle güvenli biçimde seçilemedi. Çeviriyi kopyalayın veya kaynak metni elle seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全选中当前句子。请复制译文，或手动选择原文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全地選取目前句子。請複製譯文，或手動選取原文。"
          }
        }
      }
    },
    "Could not verify the replacement. Check the editor. The card keeps copy actions for the source and translation to avoid another overwrite.": {
      "comment": "Recovery guidance when Accessibility cannot confirm whether the editor applied the replacement.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من الاستبدال. راجع النص في المحرر. تتضمن البطاقة إجراءات لنسخ النص المصدر والترجمة لتجنّب استبدال النص مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ersetzen konnte nicht überprüft werden. Prüfe den Editor. Auf der Karte kannst du weiterhin Ausgangstext und Übersetzung kopieren, damit nichts versehentlich überschrieben wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el reemplazo. Comprueba el editor. La tarjeta conserva las opciones para copiar el texto de origen y la traducción, y así evitar sobrescribirlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier le remplacement. Vérifiez l’éditeur. La carte conserve les actions de copie pour la source et la traduction afin d’éviter un autre écrasement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलाव की पुष्टि नहीं हो सकी। संपादक जाँचें। कार्ड में स्रोत और अनुवाद कॉपी करने के विकल्प उपलब्ध हैं, ताकि पाठ फिर से अनजाने में न बदले।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penggantian tidak dapat diverifikasi. Periksa editor. Kartu tetap menyediakan tindakan untuk menyalin teks sumber dan terjemahan agar teks tidak tertimpa lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare la sostituzione. Controlla l’editor. La scheda mantiene le opzioni per copiare il testo originale e la traduzione, così eviti un’altra sovrascrittura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置換結果を確認できませんでした。エディタを確認してください。上書きを避けるため、カードには原文と翻訳のコピー操作が残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교체를 확인할 수 없습니다. 편집기를 확인하세요. 다시 덮어쓰지 않도록 카드에서 원문과 번역을 복사할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a substituição. Confira o editor. O cartão mantém as opções para copiar o texto de origem e a tradução, evitando sobrescrever o texto novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить замену. Проверьте текст в редакторе. На карточке остаются кнопки копирования исходного текста и перевода, чтобы избежать повторной перезаписи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirme doğrulanamadı. Düzenleyiciyi kontrol edin. Başka bir metnin üzerine yazma riskini önlemek için kartta kaynak metni ve çeviriyi kopyalama seçenekleri bulunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认替换是否成功，请检查编辑器。卡片保留原文和译文的复制操作，避免再次覆盖文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認編輯器是否已套用取代。請檢查編輯器。卡片仍提供複製原文與譯文的操作，避免再次覆寫。"
          }
        }
      }
    },
    "Could not verify the sentence selection. No text was replaced; select the source manually or copy the translation.": {
      "comment": "Error shown when the selected sentence does not match the saved source; replacement has not run.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من تحديد الجملة. لم يُستبدل أي نص؛ حدّد النص المصدر يدويًا أو انسخ الترجمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
