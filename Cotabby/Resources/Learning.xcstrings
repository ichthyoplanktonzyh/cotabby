      }
    },
    "Repeated text could not be located reliably; you can still read the translation and look up words.": {
      "comment": "Status shown when repeated phrases make alignment ambiguous but translation and lookup remain available.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديد مواضع النص المتكرر بثقة؛ لا يزال بإمكانك قراءة الترجمة والبحث عن الكلمات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholter Text ließ sich nicht zuverlässig zuordnen. Du kannst die Übersetzung weiterhin lesen und Wörter nachschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo localizar el texto repetido de forma fiable; aún puedes leer la traducción y consultar palabras en el diccionario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte répété n’a pas pu être localisé de manière fiable ; vous pouvez tout de même lire la traduction et rechercher des mots."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहराए गए पाठांशों का सटीक मिलान नहीं हो सका; आप अनुवाद पढ़ सकते हैं और शब्द डिक्शनरी में देख सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks berulang tidak dapat ditemukan dengan andal; Anda tetap dapat membaca terjemahan dan mencari kata."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile individuare con affidabilità il testo ripetuto; puoi comunque leggere la traduzione e cercare le parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じフレーズが繰り返されているため、対応箇所を確実に特定できませんでした。翻訳の閲覧と単語の検索は引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복되는 텍스트를 안정적으로 찾을 수 없습니다. 번역을 읽고 단어를 찾아볼 수는 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível localizar o texto repetido com segurança; ainda é possível ler a tradução e consultar palavras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось надёжно определить повторяющийся фрагмент; вы по-прежнему можете читать перевод и искать слова в словаре."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yinelenen metnin yeri güvenilir biçimde belirlenemedi; çeviriyi okuyabilir ve kelimeleri arayabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法可靠定位重复文本；你仍可阅读译文并查询单词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法可靠地定位重複文字；你仍可閱讀譯文並查詢單字。"
          }
        }
      }
    },
