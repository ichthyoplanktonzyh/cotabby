          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’allineamento delle frasi non è disponibile; puoi comunque leggere la traduzione e cercare le parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーズ照合は利用できません。翻訳の閲覧と単語の検索は引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
