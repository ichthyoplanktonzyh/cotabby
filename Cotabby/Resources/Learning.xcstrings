    "This shortcut conflicts with %@. Choose a different key combination.": {
      "comment": "Explains why the learning shortcut cannot be used; the conflicting command name is inserted.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعارض هذا الاختصار مع %@. اختر مجموعة مفاتيح مختلفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kurzbefehl steht mit %@ in Konflikt. Wähle eine andere Tastenkombination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este atajo entra en conflicto con %@. Elige otra combinación de teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce raccourci entre en conflit avec %@. Choisissez une autre combinaison de touches."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह शॉर्टकट %@ से टकराता है। कुंजियों का कोई दूसरा संयोजन चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan ini bertentangan dengan %@. Pilih kombinasi tombol lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa scorciatoia è in conflitto con %@. Scegli una combinazione di tasti diversa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このショートカットは%@と競合しています。別のキーの組み合わせを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단축키는 %@과(와) 충돌합니다. 다른 키 조합을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este atalho conflita com %@. Escolha outra combinação de teclas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сочетание клавиш конфликтует с действием «%@». Выберите другое сочетание."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayol %@ ile çakışıyor. Başka bir tuş kombinasyonu seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此快捷键与 %@ 冲突。请选择其他按键组合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此快速鍵與 %@ 衝突。請選擇其他按鍵組合。"
          }
        }
      }
    },
