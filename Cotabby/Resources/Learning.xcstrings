    "TranslateGemma input exceeds 2,048 tokens. Split the text into smaller parts.": {
      "comment": "Error shown when input exceeds TranslateGemma's supported token budget.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاوز مُدخل TranslateGemma حد 2,048 رمزًا. قسّم النص إلى أجزاء أصغر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die TranslateGemma-Eingabe überschreitet 2.048 Tokens. Teile den Text in kleinere Abschnitte auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrada de TranslateGemma supera los 2048 tokens. Divide el texto en partes más pequeñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’entrée TranslateGemma dépasse 2 048 jetons. Divisez le texte en parties plus petites."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TranslateGemma इनपुट 2,048 टोकन से बड़ा है। पाठ को छोटे हिस्सों में बाँटें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Input TranslateGemma melebihi 2.048 token. Bagi teks menjadi beberapa bagian yang lebih kecil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’input per TranslateGemma supera i 2.048 token. Dividi il testo in parti più brevi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TranslateGemmaの入力が2,048トークンを超えています。テキストを短く分割してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TranslateGemma 입력이 2,048토큰을 초과합니다. 텍스트를 더 작은 부분으로 나누세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A entrada do TranslateGemma excede 2.048 tokens. Divida o texto em partes menores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ввод для TranslateGemma превышает 2 048 токенов. Разделите текст на части поменьше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TranslateGemma girdisi 2.048 belirteci aşıyor. Metni daha küçük parçalara bölün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TranslateGemma 输入超过 2,048 个 token。请将文本拆分成更小的部分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TranslateGemma 輸入超過 2,048 個 Token。請將文字拆成較小部分。"
          }
        }
      }
    },
