      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان خادم متوافق مع OpenAI. يضيف Lingrove /v1 عندما لا يحتوي العنوان على مسار؛ ويستخدم Ollama العنوان http://127.0.0.1:11434 افتراضيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse des OpenAI-kompatiblen Servers. Lingrove fügt /v1 hinzu, wenn die Adresse keinen Pfad enthält; Ollama verwendet standardmäßig http://127.0.0.1:11434."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección del servidor compatible con OpenAI. Lingrove añade /v1 cuando la dirección no tiene ruta; Ollama usa http://127.0.0.1:11434 de forma predeterminada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse du serveur compatible avec OpenAI. Lingrove ajoute /v1 lorsque l’adresse n’a pas de chemin ; Ollama utilise http://127.0.0.1:11434 par défaut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI-संगत सर्वर का पता। पते में पाथ न होने पर Lingrove /v1 जोड़ता है; Ollama डिफ़ॉल्ट रूप से http://127.0.0.1:11434 उपयोग करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat server kompatibel OpenAI. Lingrove menambahkan /v1 saat alamat tidak memiliki jalur; Ollama menggunakan http://127.0.0.1:11434 secara default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indirizzo del server compatibile con OpenAI. Lingrove aggiunge /v1 quando l'indirizzo non ha un percorso; Ollama usa http://127.0.0.1:11434 per impostazione predefinita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI互換サーバーのアドレス。パスがない場合、Lingroveは /v1 を追加します。Ollamaのデフォルトは http://127.0.0.1:11434 です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI 호환 서버 주소입니다. 주소에 경로가 없으면 Lingrove가 /v1을 추가하며, Ollama는 기본적으로 http://127.0.0.1:11434를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço do servidor compatível com OpenAI. O Lingrove adiciona /v1 quando o endereço não tem caminho; o Ollama usa http://127.0.0.1:11434 por padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес OpenAI-совместимого сервера. Если в адресе нет пути, Lingrove добавляет /v1; по умолчанию Ollama использует http://127.0.0.1:11434."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI uyumlu sunucu adresi. Adreste yol yoksa Lingrove /v1 ekler; Ollama varsayılan olarak http://127.0.0.1:11434 kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI 兼容服务器地址。如果地址没有路径，拾语会添加 /v1；Ollama 默认使用 http://127.0.0.1:11434。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI 相容伺服器位址。位址沒有路徑時，拾語會加上 /v1；Ollama 預設使用 http://127.0.0.1:11434。"
          }
        }
      }
    },
    "The color of the inline suggestion. Automatic adapts to light and dark; White suits dark editors.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لون الاقتراح المضمّن. يتكيف التلقائي مع الوضعين الفاتح والداكن؛ ويناسب الأبيض المحررات الداكنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbe des Inline-Vorschlags. Automatisch passt sich an helle und dunkle Darstellung an; Weiß eignet sich für dunkle Editoren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The color of the inline suggestion. Automatic adapts to light and dark; White suits dark editors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Color de la sugerencia en línea. Automático se adapta a los modos claro y oscuro; Blanco es adecuado para editores oscuros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleur de la suggestion intégrée. Automatique suit le mode clair ou sombre ; Blanc convient aux éditeurs sombres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनलाइन सुझाव का रंग। स्वचालित हल्के और गहरे रंगरूप के अनुसार बदलता है; सफ़ेद गहरे एडिटर के लिए उपयुक्त है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna saran sebaris. Otomatis menyesuaikan tema terang dan gelap; Putih cocok untuk editor gelap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore del suggerimento in linea. Automatico si adatta al tema chiaro o scuro; Bianco è adatto agli editor scuri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インライン候補の色です。「自動」は明暗に適応し、「白」は暗いエディタに適しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인라인 제안의 색상입니다. 자동은 밝고 어두운 화면에 맞추며 흰색은 어두운 편집기에 적합합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cor da sugestão em linha. Automático se adapta aos modos claro e escuro; Branco é adequado a editores escuros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвет встроенной подсказки. Автоматический учитывает светлую и тёмную тему; белый подходит для тёмных редакторов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satır içi önerinin rengi. Otomatik, açık ve koyu görünüme uyum sağlar; Beyaz koyu editörlere uygundur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行内建议的颜色。“自动”适应明暗外观；“白色”适用于深色编辑器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行內建議的顏色。「自動」會適應明暗外觀；「白色」適用於深色編輯器。"
          }
        }
      }
    },
    "The configured GGUF file is unavailable. Choose a model again.": {
      "comment": "Status shown when a selected local model file can no longer be found.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف GGUF المُعدّ غير متاح. اختر نموذجًا من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die konfigurierte GGUF-Datei ist nicht verfügbar. Wähle erneut ein Modell aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo GGUF configurado no está disponible. Vuelve a elegir un modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier GGUF configuré est indisponible. Choisissez à nouveau un modèle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फ़िगर की गई GGUF फ़ाइल उपलब्ध नहीं है। कोई मॉडल फिर चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File GGUF yang dikonfigurasi tidak tersedia. Pilih model lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file GGUF configurato non è disponibile. Scegli di nuovo un modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定したGGUFファイルを利用できません。モデルを選び直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성된 GGUF 파일을 사용할 수 없습니다. 모델을 다시 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo GGUF configurado está indisponível. Escolha um modelo novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Указанный файл GGUF недоступен. Выберите модель ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapılandırılmış GGUF dosyası kullanılamıyor. Yeniden model seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配置的 GGUF 文件不可用。请重新选择模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到已設定的 GGUF 檔案。請重新選擇模型。"
          }
        }
      }
    },
    "The current sentence could not be encoded.": {
      "comment": "Error shown when the source sentence cannot be safely encoded for a learning request.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر ترميز الجملة الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Satz konnte nicht kodiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo codificar la oración actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phrase actuelle n’a pas pu être encodée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा वाक्य को एन्कोड नहीं किया जा सका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalimat saat ini tidak dapat dikodekan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile codificare la frase corrente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の文をエンコードできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 문장을 인코딩할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível codificar a frase atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось закодировать текущее предложение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli cümle güvenli biçimde kodlanamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法对当前句子进行编码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法編碼目前句子。"
          }
        }
      }
    },
    "The current sentence extends beyond the verifiable range. Select text manually; truncated text was not sent.": {
      "comment": "Error shown when sentence boundaries extend outside verified editor text; no truncated content was sent.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجاوز الجملة الحالية النطاق الذي يمكن التحقق منه. حدّد النص يدويًا؛ لم يُرسل أي نص مبتور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Satz reicht über den überprüfbaren Bereich hinaus. Wähle den Text manuell aus; gekürzter Text wurde nicht gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La oración actual rebasa el rango que se puede verificar. Selecciona el texto manualmente; no se envió texto truncado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phrase actuelle dépasse la plage vérifiable. Sélectionnez le texte manuellement ; le texte tronqué n’a pas été envoyé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा वाक्य सत्यापित की जा सकने वाली सीमा से आगे तक फैला है। पाठ मैन्युअल रूप से चुनें; काटा हुआ पाठ नहीं भेजा गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalimat saat ini melampaui rentang yang dapat diverifikasi. Pilih teks secara manual; teks yang terpotong tidak dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La frase corrente supera l’intervallo verificabile. Seleziona il testo manualmente; il testo troncato non è stato inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の文が確認可能な範囲を超えています。テキストを手動で選択してください。切り詰めたテキストは送信されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 문장이 확인 가능한 범위를 벗어납니다. 텍스트를 직접 선택하세요. 잘린 텍스트는 전송되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A frase atual ultrapassa o trecho que pode ser verificado. Selecione o texto manualmente; o texto truncado não foi enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущее предложение выходит за пределы проверяемого диапазона. Выделите текст вручную; усечённый текст не отправлялся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli cümle doğrulanabilir aralığın dışına taşıyor. Metni elle seçin; kesilmiş metin gönderilmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前句子超出可验证范围。请手动选择文本；未发送被截断的文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前句子超出可驗證範圍。請手動選取文字；遭截短的文字不會傳送。"
          }
        }
      }
    },
    "The current sentence is empty or exceeds 6 KB.": {
      "comment": "Error shown when chunk alignment receives an empty or oversized source sentence.\nError shown when sentence preview receives an empty or oversized sentence.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجملة الحالية فارغة أو يتجاوز حجمها 6 كيلوبايت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Satz ist leer oder größer als 6 KB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La oración actual está vacía o supera los 6 KB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phrase actuelle est vide ou dépasse 6 Ko."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा वाक्य खाली है या 6 KB से बड़ा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalimat saat ini kosong atau melebihi 6 KB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La frase corrente è vuota o supera i 6 KB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の文が空か、6 KBを超えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 문장이 비어 있거나 6KB를 초과합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A frase atual está vazia ou excede 6 KB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущее предложение пусто или превышает 6 КБ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli cümle boş veya 6 KB'tan büyük."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前句子为空或超过 6 KB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前句子是空的，或超過 6 KB。"
          }
        }
      }
    },
    "The editor could not select the current sentence. Select the source manually or copy the translation.": {
      "comment": "Recovery guidance when the editor refuses to select the current sentence.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على المحرر تحديد الجملة الحالية. حدّد النص المصدر يدويًا أو انسخ الترجمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Editor konnte den aktuellen Satz nicht auswählen. Wähle den Ausgangstext manuell aus oder kopiere die Übersetzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El editor no pudo seleccionar la oración actual. Selecciona el texto de origen manualmente o copia la traducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’éditeur n’a pas pu sélectionner la phrase actuelle. Sélectionnez la source manuellement ou copiez la traduction."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपादक मौजूदा वाक्य नहीं चुन सका। स्रोत पाठ मैन्युअल रूप से चुनें या अनुवाद कॉपी करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor tidak dapat memilih kalimat saat ini. Pilih teks sumber secara manual atau salin terjemahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’editor non è riuscito a selezionare la frase corrente. Seleziona manualmente il testo originale o copia la traduzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタで現在の文を選択できませんでした。原文を手動で選択するか、翻訳をコピーしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집기에서 현재 문장을 선택할 수 없습니다. 원문을 직접 선택하거나 번역을 복사하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor não conseguiu selecionar a frase atual. Selecione o texto de origem manualmente ou copie a tradução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактор не смог выделить текущее предложение. Выделите исходный текст вручную или скопируйте перевод."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenleyici geçerli cümleyi seçemedi. Kaynak metni elle seçin veya çeviriyi kopyalayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑器无法选中当前句子。请手动选择原文或复制译文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯器無法選取目前句子。請手動選取原文，或複製譯文。"
          }
        }
      }
    },
    "The editor refused the replacement. Check the source text; you can copy the translation or restore the original.": {
      "comment": "Recovery guidance when the editor rejects a confirmed selection replacement.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض المحرر الاستبدال. تحقّق من النص المصدر؛ يمكنك نسخ الترجمة أو استعادة النص الأصلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Editor hat das Ersetzen abgelehnt. Prüfe den Ausgangstext. Du kannst die Übersetzung kopieren oder den Originaltext wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El editor rechazó el reemplazo. Comprueba el texto de origen; puedes copiar la traducción o restaurar el original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’éditeur a refusé le remplacement. Vérifiez le texte source ; vous pouvez copier la traduction ou rétablir l’original."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपादक ने पाठ बदलने से इनकार कर दिया। स्रोत पाठ जाँचें; आप अनुवाद कॉपी कर सकते हैं या मूल पाठ वापस ला सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor menolak penggantian. Periksa teks sumber; Anda dapat menyalin terjemahan atau memulihkan teks asli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’editor ha rifiutato la sostituzione. Controlla il testo originale; puoi copiare la traduzione o ripristinare il testo originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタが置換を拒否しました。原文を確認してください。翻訳をコピーするか、原文を復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집기에서 교체를 거부했습니다. 원문을 확인하세요. 번역을 복사하거나 원문을 복원할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor recusou a substituição. Confira o texto de origem; você pode copiar a tradução ou restaurar o original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактор отказался заменять текст. Проверьте исходный текст; можно скопировать перевод или восстановить оригинал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenleyici değiştirmeyi reddetti. Kaynak metni kontrol edin; çeviriyi kopyalayabilir veya özgün metni geri yükleyebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑器拒绝了替换操作。请检查原文；你可以复制译文或还原原文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯器拒絕取代文字。請檢查原文；你可以複製譯文，或還原原文。"
          }
        }
      }
    },
    "The endpoint did not return a complete text response.": {
