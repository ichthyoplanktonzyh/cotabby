    "On keeps the global auto-fix choice; Off disables typo checks in this app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التشغيل يحافظ على اختيار التصحيح التلقائي العام؛ والإيقاف يعطل فحص الأخطاء في هذا التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein übernimmt die globale Autokorrekturwahl; Aus deaktiviert die Tippfehlerprüfung in dieser App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On keeps the global auto-fix choice; Off disables typo checks in this app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado conserva la opción global de autocorrección; Desactivado apaga la revisión de errores en esta aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé conserve le choix global de correction automatique ; Désactivé coupe la vérification dans cette app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू होने पर वैश्विक ऑटो-फ़िक्स विकल्प रहेगा; बंद होने पर इस ऐप की टाइपो जाँच रुक जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif mengikuti pilihan perbaikan otomatis global; Nonaktif mematikan pemeriksaan salah ketik aplikasi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo mantiene la scelta globale di correzione automatica; Disattivo spegne il controllo dei refusi in questa app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンでは全体の自動修正設定に従い、オフではこのアプリの誤字チェックを無効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 전역 자동 수정 설정을 따르고, 끄면 이 앱의 오타 검사를 중지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado mantém a opção global de correção automática; Desativado desliga a verificação de erros neste app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкл. сохраняет общую настройку автозамены; Выкл. отключает проверку опечаток в приложении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık, genel otomatik düzeltme seçimini korur; Kapalı, bu uygulamanın yazım denetimini kapatır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启时沿用全局自动替换设置；关闭时停用此应用的拼写检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟時沿用全域自動取代設定；關閉時停用此應用程式的拼字檢查。"
          }
        }
      }
    },
    "Optional bearer token stored in Keychain. Connect saves this task's key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز وصول اختياري من نوع Bearer يُخزّن في سلسلة المفاتيح. يحفظ زر «اتصال» مفتاح هذه المهمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionales Bearer-Token, das im Schlüsselbund gespeichert wird. Mit „Verbinden“ speicherst du den Schlüssel für diese Aufgabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Token Bearer opcional guardado en el llavero. Al conectarte se guarda la clave de esta tarea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeton bearer facultatif stocké dans le trousseau. Le bouton Connecter enregistre la clé de cette tâche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक bearer token Keychain में संग्रहीत होता है। Connect करने पर इस कार्य की कुंजी सहेजी जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Token bearer opsional yang disimpan di Keychain. Hubungkan untuk menyimpan kunci tugas ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Token Bearer facoltativo, salvato nel Portachiavi. Connetti salva la chiave di questa attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychainに保存される任意のベアラートークン。接続すると、このタスクのキーが保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키체인에 저장된 선택적 bearer 토큰입니다. 연결하면 이 작업의 키를 저장합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Token bearer opcional armazenado no Acesso às Chaves. Ao conectar, a chave desta tarefa será salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательный токен Bearer хранится в Связке ключей. При подключении сохраняется ключ для этой задачи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain'de saklanan isteğe bağlı bearer token. Bağlan düğmesi bu görevin anahtarını kaydeder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储在钥匙串中的可选 Bearer 令牌。连接后会保存此任务的密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選用的 Bearer 權杖會儲存在鑰匙圈中。按一下「連線」即可儲存這項工作的金鑰。"
          }
        }
      }
    },
    "Optional. Lets Lingrove screenshot the focused window for extra context. Without it, suggestions still work, but screen context is unavailable.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري. يتيح لـ Lingrove التقاط لقطة شاشة للنافذة النشطة للحصول على سياق إضافي. تظل الاقتراحات تعمل بدونه، لكن سياق الشاشة غير متاح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Lingrove kann das fokussierte Fenster als Screenshot aufnehmen, um zusätzlichen Kontext zu erfassen. Ohne diese Berechtigung funktionieren Vorschläge weiterhin, aber Bildschirmkontext steht nicht zur Verfügung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: permite que Lingrove haga una captura de la ventana enfocada para obtener más contexto. Sin este permiso, las sugerencias siguen funcionando, pero el contexto de pantalla no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Permet à Lingrove de capturer la fenêtre active pour obtenir davantage de contexte. Sans cette autorisation, les suggestions continuent de fonctionner, mais le contexte à l’écran est indisponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। Lingrove को अतिरिक्त संदर्भ के लिए फ़ोकस की गई विंडो का स्क्रीनशॉट लेने देता है। इसके बिना सुझाव फिर भी काम करते हैं, लेकिन स्क्रीन संदर्भ उपलब्ध नहीं होता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional. Memungkinkan Lingrove mengambil tangkapan layar jendela aktif untuk konteks tambahan. Tanpanya, saran tetap berfungsi, tetapi konteks layar tidak tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativa. Consente a Lingrove di acquisire uno screenshot della finestra attiva per aggiungere contesto. Senza questa autorizzazione, i suggerimenti continuano a funzionare, ma il contesto dello schermo non è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意。追加のコンテキストのためにLingroveがフォーカス中のウィンドウをスクリーンショットできます。許可しなくても候補は動作しますが、画面コンテキストは利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항. 추가 컨텍스트를 위해 Lingrove가 포커스된 윈도우를 스크린샷으로 캡처하도록 합니다. 없어도 제안은 작동하지만 화면 컨텍스트를 사용할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Permite que o Lingrove faça uma captura da janela em foco para obter contexto adicional. Sem isso, as sugestões continuam funcionando, mas o contexto da tela fica indisponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно. Позволяет Lingrove делать снимок окна в фокусе для дополнительного контекста. Без этого подсказки по-прежнему работают, но контекст экрана недоступен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Lingrove'nin ek bağlam için odaklanılan pencerenin ekran görüntüsünü almasını sağlar. Bu olmadan da öneriler çalışır, ancak ekran bağlamı kullanılamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。允许拾语截取聚焦窗口的屏幕截图以提供额外上下文。没有此权限，建议仍可正常工作，但屏幕上下文不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選用功能：讓拾語擷取目前聚焦視窗的螢幕畫面，以取得額外內容。沒有此權限時，建議仍可運作，但無法使用螢幕內容。"
          }
        }
      }
    },
