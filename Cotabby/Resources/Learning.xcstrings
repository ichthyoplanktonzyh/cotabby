            "state": "translated",
            "value": "모델이 불완전한 텍스트 인코딩을 반환했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo retornou uma codificação de texto incompleta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель вернула текст с неполной последовательностью UTF-8."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model eksik bir metin kodlaması döndürdü."
          }
