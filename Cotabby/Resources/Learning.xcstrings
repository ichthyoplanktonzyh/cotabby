          "stringUnit": {
            "state": "translated",
            "value": "拾語保持安靜的地方"
          }
        }
      }
    },
    "Whether Lingrove can reach the server and list its models.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما إذا كان بإمكان Lingrove الوصول إلى الخادم وسرد نماذجه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob Lingrove den Server erreichen und seine Modelle auflisten kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Lingrove puede acceder al servidor y enumerar sus modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique si Lingrove peut joindre le serveur et répertorier ses modèles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove सर्वर तक पहुँच सकता है और उसके मॉडल सूचीबद्ध कर सकता है या नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Lingrove dapat menjangkau server dan mencantumkan modelnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se Lingrove può raggiungere il server ed elencarne i modelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingroveがサーバーに接続してモデル一覧を取得できるかどうか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove가 서버에 연결하여 모델을 나열할 수 있는지 여부."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o Lingrove consegue acessar o servidor e listar seus modelos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может ли Lingrove подключиться к серверу и получить список его моделей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove'nin sunucuya erişip modellerini listeleyebilmesi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾语是否可以连接服务器并列出其模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拾語是否能連線至伺服器並列出其模型。"
          }
        }
      }
    },
