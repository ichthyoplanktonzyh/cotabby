        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय अभिव्यक्ति डिक्शनरी पढ़ी नहीं जा सकी। आप अलग-अलग शब्द अब भी देख सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamus ungkapan lokal tidak dapat dibaca. Anda tetap dapat mencari kata satu per satu."
