      }
    },
    "The source language could not be confirmed or matches the target. Adjust the source-language settings or select more text.": {
      "comment": "Error shown when a translation direction cannot be resolved from the selected source languages and target.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديد اتجاه الترجمة لأن لغة المصدر غير مؤكدة أو تطابق اللغة الهدف. عدّل إعدادات لغة المصدر أو حدّد نصًا أكثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgangssprache konnte nicht bestätigt werden oder entspricht der Zielsprache. Passe die Einstellungen für Ausgangssprachen an oder wähle mehr Text aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el idioma de origen o coincide con el de destino. Ajusta los idiomas de origen en los ajustes o selecciona más texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue source n’a pas pu être confirmée ou correspond à la cible. Ajustez les réglages de langue source ou sélectionnez davantage de texte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्रोत भाषा की पुष्टि नहीं हो सकी या वह लक्ष्य भाषा से मेल खाती है। स्रोत-भाषा सेटिंग बदलें या अधिक पाठ चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahasa sumber tidak dapat dipastikan atau sama dengan bahasa target. Sesuaikan pengaturan bahasa sumber atau pilih lebih banyak teks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile confermare la lingua originale oppure coincide con quella di destinazione. Modifica le impostazioni della lingua di origine o seleziona più testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原文の言語を確認できないか、翻訳先の言語と一致しています。原文の言語設定を調整するか、テキストを多めに選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원문 언어를 확인할 수 없거나 대상 언어와 같습니다. 원문 언어 설정을 조정하거나 텍스트를 더 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar o idioma de origem ou ele é igual ao idioma de destino. Ajuste os idiomas de origem nas configurações ou selecione mais texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить исходный язык или он совпадает с языком перевода. Измените настройки исходных языков или выделите больше текста."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak dil doğrulanamadı veya hedef dille aynı. Kaynak dil ayarlarını değiştirin ya da daha fazla metin seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认原文语言，或原文语言与目标语言相同。请调整原文语言设置或选择更多文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認來源語言，或來源語言與目標語言相同。請調整來源語言設定，或選取更多文字。"
          }
        }
      }
    },
    "The source language is not enabled or matches the target. Check the translation settings.": {
      "comment": "Error shown when the requested translation direction is not enabled or has identical source and target languages.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لغة المصدر غير مفعّلة أو تطابق اللغة الهدف. تحقّق من إعدادات الترجمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgangssprache ist nicht aktiviert oder entspricht der Zielsprache. Prüfe die Übersetzungseinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de origen no está activado o coincide con el de destino. Comprueba los ajustes de traducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue source n’est pas activée ou correspond à la cible. Vérifiez les réglages de traduction."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्रोत भाषा सक्षम नहीं है या लक्ष्य भाषा से मेल खाती है। अनुवाद सेटिंग जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahasa sumber tidak diaktifkan atau sama dengan bahasa target. Periksa pengaturan terjemahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua di origine non è attiva oppure coincide con quella di destinazione. Controlla le impostazioni di traduzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原文の言語が有効になっていないか、翻訳先の言語と一致しています。翻訳設定を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원문 언어가 활성화되지 않았거나 대상 언어와 같습니다. 번역 설정을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma de origem não está ativado ou é igual ao idioma de destino. Confira as configurações de tradução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный язык не включён или совпадает с языком перевода. Проверьте настройки перевода."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak dil etkin değil veya hedef dille aynı. Çeviri ayarlarını kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文语言未启用，或与目标语言相同。请检查翻译设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源語言未啟用，或與目標語言相同。請檢查翻譯設定。"
          }
        }
      }
    },
    "The source text and output budget exceed the local model's context limit. Split the text into smaller parts.": {
      "comment": "Error shown when the source text plus requested output exceeds the local model context window.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاوز النص المصدر وميزانية الإخراج حدّ سياق النموذج المحلي. قسّم النص إلى أجزاء أصغر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ausgangstext und das Ausgabelimit überschreiten das Kontextlimit des lokalen Modells. Teile den Text in kleinere Abschnitte auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto de origen y el presupuesto de salida superan el límite de contexto del modelo local. Divide el texto en partes más pequeñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte source et le budget de sortie dépassent la limite de contexte du modèle local. Divisez le texte en parties plus petites."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्रोत पाठ और आउटपुट बजट मिलकर स्थानीय मॉडल की संदर्भ सीमा से अधिक हैं। पाठ को छोटे हिस्सों में बाँटें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks sumber dan anggaran output melebihi batas konteks model lokal. Bagi teks menjadi beberapa bagian yang lebih kecil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo originale e il budget di output superano il limite di contesto del modello locale. Dividi il testo in parti più brevi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原文と出力予算の合計がローカルモデルのコンテキスト上限を超えています。テキストを短く分割してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원문 텍스트와 출력 예산이 로컬 모델의 컨텍스트 한도를 초과합니다. 텍스트를 더 작은 부분으로 나누세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto de origem e o limite de saída excedem o contexto máximo do modelo local. Divida o texto em partes menores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный текст и выделенный лимит для ответа превышают контекстное окно локальной модели. Разделите текст на более короткие части."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak metin ve çıktı bütçesi yerel modelin bağlam sınırını aşıyor. Metni daha küçük parçalara bölün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文和输出预算超出本地模型的上下文限制。请将文本拆分成更小的部分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原文與輸出 Token 預算超出本機模型的上下文上限。請將文字拆成較小部分。"
          }
        }
      }
    },
    "The text exceeds 6 KB. No text was sent or truncated.": {
      "comment": "Error shown before a request when the source text exceeds the limit; no part of it was sent or shortened.",
      "localizations": {
