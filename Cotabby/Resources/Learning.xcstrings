    "With this endpoint, this text is sent to the configured HTTPS remote service.": {
      "comment": "Privacy notice shown when the learning endpoint uses a public HTTPS host.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسل هذا النص إلى الخدمة البعيدة المضبوطة عبر HTTPS عند استخدام نقطة النهاية هذه."
          }
        },
        "de": {
