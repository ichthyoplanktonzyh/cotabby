    "Turn suggestions off in this app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف الاقتراحات في هذا التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge in dieser App ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn suggestions off in this app."
          }
        },
        "es": {
          "stringUnit": {
