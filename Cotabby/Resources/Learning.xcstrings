    "Set automatically by power source. Use the On Battery / Plugged In pickers above.": {
      "comment": "Explains that power profiles choose the active model automatically.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحدّد تلقائيًا حسب مصدر الطاقة. استخدم خياري «على البطارية» و«موصول بالطاقة» أعلاه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird automatisch anhand der Stromquelle festgelegt. Verwende oben die Auswahlfelder „Batteriebetrieb“ / „Netzbetrieb“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo establece automáticamente la fuente de alimentación. Usa los selectores Con batería / Conectado a la corriente de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défini automatiquement par la source d’alimentation. Utilisez les sélecteurs Sur batterie / Sur secteur ci-dessus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पावर स्रोत के अनुसार अपने आप सेट होता है। ऊपर के On Battery / Plugged In विकल्प इस्तेमाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diatur otomatis berdasarkan sumber daya. Gunakan pemilih Saat Menggunakan Baterai / Saat Terhubung ke Daya di atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostato automaticamente in base alla fonte di alimentazione. Usa i selettori A batteria / Collegato all’alimentazione qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源に応じて自動設定されます。上の「バッテリー使用時」／「電源アダプタ接続時」で選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원 소스에 따라 자동 설정됩니다. 위의 배터리 사용 중/전원 연결됨 선택기를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Definido automaticamente pela fonte de energia. Use os seletores Na bateria / Conectado à tomada acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирается автоматически в зависимости от источника питания. Используйте расположенные выше списки «От аккумулятора» и «При подключённом питании»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güç kaynağına göre otomatik ayarlanır. Yukarıdaki Pilde / Prize takılı seçicilerini kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据电源自动设置。请使用上方“使用电池时 / 接通电源时”的选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由電源自動選擇。請使用上方的「使用電池／接上電源」選擇器。"
          }
        }
      }
    },
    "Show sentence expressions after a pause": {
      "comment": "Automatically translates newly typed complete sentences after a brief pause.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض التعبيرات المقابلة للجمل بعد توقف الكتابة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Satzübersetzungen nach einer Pause anzeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar la traducción de las oraciones tras una pausa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les expressions de la phrase après une pause"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विराम के बाद वाक्य का अनुवाद दिखाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan terjemahan kalimat setelah jeda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la traduzione delle frasi dopo una pausa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力が止まると文の翻訳を表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 후 문장 표현 표시"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar a tradução da frase após uma pausa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать переводы предложений после паузы"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazmaya ara verince cümleleri çevir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停输入后显示句子表达"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停輸入後顯示句子譯文"
          }
        }
      }
    },
    "Shows the active selection. Downloaded models must also be selected here.": {
      "comment": "Explains that downloading a model does not select it automatically.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض الاختيار النشط. ويجب أيضًا تحديد النماذج التي تم تنزيلها هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die aktive Auswahl. Heruntergeladene Modelle müssen auch hier ausgewählt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la selección activa. Los modelos descargados también deben seleccionarse aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la sélection active. Les modèles téléchargés doivent également être sélectionnés ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सक्रिय चयन दिखाता है। डाउनलोड किए गए मॉडल को भी यहाँ चुनना होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan pilihan aktif. Model yang diunduh juga harus dipilih di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la selezione attiva. I modelli scaricati devono essere selezionati anche qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択内容を表示します。ダウンロード済みモデルもここで選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 선택 영역을 표시합니다. 다운로드한 모델도 여기에서 선택해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a seleção ativa. Também é preciso selecionar aqui os modelos baixados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь показана выбранная модель. Загруженные модели тоже нужно выбрать в этом списке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin seçimi gösterir. İndirilen modellerin de burada seçilmesi gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示当前选择的模型。下载的模型也必须在此处选中才能使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示目前使用的模型。下載模型後，還必須在此選取模型。"
          }
        }
      }
    },
    "Shows whether this task's local model is loaded and ready to generate.": {
      "comment": "Description of the local model status field.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوضح ما إذا كان النموذج المحلي لهذه المهمة محمّلًا وجاهزًا للتوليد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt an, ob das lokale Modell dieser Aufgabe geladen und für die Generierung bereit ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica si el modelo local de esta tarea está cargado y listo para generar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique si le modèle local de cette tâche est chargé et prêt à générer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिखाता है कि इस कार्य का स्थानीय मॉडल लोड है और जनरेट करने के लिए तैयार है या नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan apakah model lokal untuk tugas ini telah dimuat dan siap menghasilkan teks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica se il modello locale di questa attività è caricato e pronto per generare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクのローカルモデルが読み込まれ、生成できる状態かどうかを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업의 로컬 모델이 로드되어 생성할 준비가 되었는지 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra se o modelo local desta tarefa está carregado e pronto para gerar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает, загружена ли локальная модель этой задачи и готова ли она к генерации."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görevin yerel modelinin yüklü ve içerik oluşturmaya hazır olup olmadığını gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示此任务的本地模型是否已加载并可供生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示這項工作的本機模型是否已載入並可開始生成。"
          }
        }
      }
    },
    "Some matches are not highlighted; complete expressions remain available for lookup.": {
      "comment": "Status when some phrase matches cannot be highlighted, while dictionary lookup still works.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُبرز بعض المطابقات؛ لكن لا يزال بإمكانك البحث عن التعبيرات الكاملة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Zuordnungen sind nicht hervorgehoben; vollständige Ausdrücke lassen sich weiterhin nachschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas correspondencias no aparecen resaltadas; aún puedes consultar las expresiones completas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines correspondances ne sont pas surlignées ; les expressions complètes restent disponibles pour la recherche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ मेल हाइलाइट नहीं किए गए हैं; पूरी अभिव्यक्तियाँ अब भी डिक्शनरी में देखी जा सकती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagian kecocokan tidak disorot; ungkapan lengkap tetap dapat dicari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune corrispondenze non sono evidenziate; le espressioni complete restano disponibili per la ricerca nel dizionario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のフレーズ対応箇所はハイライトできませんが、表現全体を検索できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 대응 구간은 강조 표시되지 않지만, 완전한 표현은 계속 사전에서 찾아볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas correspondências não estão destacadas; ainda é possível consultar expressões completas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые соответствия не подсвечены; целые выражения по-прежнему можно искать в словаре."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı eşleşmeler vurgulanmıyor; ifadelerin tamamı sözlükte aranabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分匹配项未高亮；仍可查询完整表达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分對應內容未能標示；仍可查詢完整片語。"
          }
        }
      }
    },
    "Some phrase matches could not be located reliably; confirmed matches are kept.": {
      "comment": "Status when uncertain alignments are omitted while verified phrase matches remain visible.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديد مواضع بعض مطابقات العبارات بثقة؛ وتم الإبقاء على المطابقات المؤكدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Phrasenzuordnungen ließen sich nicht zuverlässig im Text finden; bestätigte Zuordnungen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron localizar algunas correspondencias entre frases de forma fiable; se conservan las confirmadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines correspondances d’expressions n’ont pas pu être localisées de manière fiable ; les correspondances confirmées sont conservées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ वाक्यांशों का भरोसेमंद ढंग से मिलान नहीं हो सका; पुष्ट मिलान रखे गए हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa kecocokan frasa tidak dapat ditemukan dengan andal; kecocokan yang terkonfirmasi tetap ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile individuare con affidabilità alcune corrispondenze tra frasi; vengono mantenute quelle confermate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のフレーズ対応箇所を確実に特定できなかったため、確認できた箇所だけを表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
