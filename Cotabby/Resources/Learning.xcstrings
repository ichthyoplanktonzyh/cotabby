    "Installing aria2 timed out. Lingrove will use its standard downloader.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة تثبيت aria2. سيستخدم Lingrove أداة التنزيل القياسية لديه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation von aria2 ist abgelaufen. Lingrove verwendet den Standard-Downloader."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalación de aria2 agotó el tiempo de espera. Lingrove usará su descargador estándar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’installation d’aria2 a dépassé le délai imparti. Lingrove utilisera son téléchargeur standard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "aria2 इंस्टॉल करने का समय समाप्त हो गया। Lingrove अपना मानक डाउनलोडर उपयोग करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemasangan aria2 kehabisan waktu. Lingrove akan menggunakan pengunduh standarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installazione di aria2 ha raggiunto il timeout. Lingrove userà il suo downloader standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "aria2のインストールがタイムアウトしました。Lingroveは標準のダウンローダーを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "aria2 설치 시간이 초과되었습니다. Lingrove는 표준 다운로더를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
