          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 범위에 변환할 수 있는 텍스트가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
