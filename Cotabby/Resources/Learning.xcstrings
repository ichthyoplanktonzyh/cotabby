        }
      }
    },
    "The current sentence extends beyond the verifiable range. Select text manually; truncated text was not sent.": {
      "comment": "Error shown when sentence boundaries extend outside verified editor text; no truncated content was sent.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجاوز الجملة الحالية النطاق الذي يمكن التحقق منه. حدّد النص يدويًا؛ لم يُرسل أي نص مبتور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Satz reicht über den überprüfbaren Bereich hinaus. Wähle den Text manuell aus; gekürzter Text wurde nicht gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La oración actual rebasa el rango que se puede verificar. Selecciona el texto manualmente; no se envió texto truncado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phrase actuelle dépasse la plage vérifiable. Sélectionnez le texte manuellement ; le texte tronqué n’a pas été envoyé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा वाक्य सत्यापित की जा सकने वाली सीमा से आगे तक फैला है। पाठ मैन्युअल रूप से चुनें; काटा हुआ पाठ नहीं भेजा गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalimat saat ini melampaui rentang yang dapat diverifikasi. Pilih teks secara manual; teks yang terpotong tidak dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La frase corrente supera l’intervallo verificabile. Seleziona il testo manualmente; il testo troncato non è stato inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の文が確認可能な範囲を超えています。テキストを手動で選択してください。切り詰めたテキストは送信されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 문장이 확인 가능한 범위를 벗어납니다. 텍스트를 직접 선택하세요. 잘린 텍스트는 전송되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A frase atual ultrapassa o trecho que pode ser verificado. Selecione o texto manualmente; o texto truncado não foi enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущее предложение выходит за пределы проверяемого диапазона. Выделите текст вручную; усечённый текст не отправлялся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli cümle doğrulanabilir aralığın dışına taşıyor. Metni elle seçin; kesilmiş metin gönderilmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前句子超出可验证范围。请手动选择文本；未发送被截断的文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前句子超出可驗證範圍。請手動選取文字；遭截短的文字不會傳送。"
          }
        }
      }
    },
    "The current sentence is empty or exceeds 6 KB.": {
