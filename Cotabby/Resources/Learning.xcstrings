    "Recognizing expressions… You can still double-click words to look them up.": {
      "comment": "Status while expression recognition runs; dictionary lookup is already available.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التعرّف على التعبيرات… لا يزال بإمكانك النقر نقرًا مزدوجًا على الكلمات للبحث عنها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausdrücke werden erkannt … Du kannst Wörter weiterhin per Doppelklick nachschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detectando expresiones… Aún puedes hacer doble clic en las palabras para consultarlas en el diccionario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnaissance des expressions… Vous pouvez tout de même double-cliquer sur des mots pour les rechercher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभिव्यक्तियों की पहचान हो रही है… शब्दों को देखने के लिए अब भी डबल-क्लिक कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengenali ungkapan… Anda tetap dapat mengeklik dua kali kata untuk mencarinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconoscimento delle espressioni… Puoi comunque fare doppio clic sulle parole per cercarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表現を認識中…単語は引き続きダブルクリックで調べられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표현 인식 중… 단어를 이중 클릭하여 찾아볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconhecendo expressões… Ainda é possível dar um duplo clique nas palavras para consultá-las."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание выражений… Вы по-прежнему можете искать слова двойным щелчком."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İfadeler tanınıyor… Kelimeleri aramak için yine de çift tıklayabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在识别表达…仍可双击单词查询。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在辨識片語…你仍可連按兩下單字查詢。"
          }
        }
      }
    },
    "Record the timestamp, model, and elapsed time of every LLM request across completion, translation and analysis. Only the most recent %lld requests are retained.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الطابع الزمني والنموذج والمدة المنقضية لكل طلب LLM عبر الإكمال والترجمة والتحليل. لا يحتفظ السجل إلا بأحدث %lld من الطلبات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitstempel, Modell und Dauer jeder LLM-Anfrage für Vervollständigung, Übersetzung und Analyse aufzeichnen. Nur die letzten %lld Anfragen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la fecha y hora, el modelo y el tiempo transcurrido de cada solicitud al LLM para autocompletado, traducción y análisis. Solo se conservan las %lld solicitudes más recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer l’horodatage, le modèle et la durée de chaque requête LLM pour l’autocomplétion, la traduction et l’analyse. Seules les %lld requêtes les plus récentes sont conservées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटोकम्प्लीट, अनुवाद और विश्लेषण के हर LLM अनुरोध का टाइमस्टैम्प, मॉडल और लगा समय रिकॉर्ड करें। केवल पिछले %lld अनुरोध रखे जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat waktu, model, dan durasi setiap permintaan LLM pada pelengkapan otomatis, terjemahan, dan analisis. Hanya %lld permintaan terbaru yang disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra data e ora, modello e tempo trascorso di ogni richiesta LLM per il completamento, la traduzione e l’analisi. Si conservano solo le richieste più recenti, fino a un massimo di %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "補完、翻訳、分析のすべてのLLMリクエストについて、タイムスタンプ、モデル、処理時間を記録します。直近%lld件だけを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 완성, 번역 및 분석 전반에서 모든 LLM 요청의 시각, 모델, 경과 시간을 기록합니다. 최근 %lld개의 요청만 보관됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar a data e hora, o modelo e o tempo decorrido de cada solicitação ao LLM, incluindo preenchimento automático, tradução e análise. Somente as %lld solicitações mais recentes são mantidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывать временную метку, модель и длительность каждого запроса LLM для автодополнения, перевода и анализа. Сохраняются только последние %lld запросов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik tamamlama, çeviri ve analizdeki her LLM isteğinin zaman damgasını, modelini ve geçen süresini kaydedin. Yalnızca en son %lld istek saklanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录自动补全、翻译和分析的每个 LLM 请求的时间戳、模型和耗时。仅保留最近 %lld 个请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄自動完成、翻譯與分析中每次 LLM 要求的時間戳記、模型與耗時。只保留最近 %lld 筆要求。"
          }
        }
      }
    },
    "Remove %@ from Cotabby's local models folder?": {
      "comment": "Confirmation message naming the local model file that will be removed.",
      "localizations": {
        "ar": {
          "stringUnit": {
