        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय अभिव्यक्ति डिक्शनरी पढ़ी नहीं जा सकी। आप अलग-अलग शब्द अब भी देख सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
