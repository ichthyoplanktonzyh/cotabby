          }
        }
      }
    },
    "Chunk alignment is unavailable; you can still read the translation and look up words.": {
      "comment": "Status shown when phrase-alignment output cannot be parsed but the translation remains usable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطابقة العبارات غير متاحة؛ لا يزال بإمكانك قراءة الترجمة والبحث عن الكلمات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Phrasenzuordnung ist nicht verfügbar. Du kannst die Übersetzung weiterhin lesen und Wörter nachschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La correspondencia de frases no está disponible; aún puedes leer la traducción y consultar palabras en el diccionario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La correspondance des expressions est indisponible ; vous pouvez tout de même lire la traduction et rechercher des mots."
          }
        },
        "hi": {
          "stringUnit": {
