          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選文字與欄位中的範圍不符；原文仍保留。"
          }
        }
      }
    },
    "The selection changed; the original text was kept.": {
      "comment": "Error shown when the selection changes just before a confirmed replacement.",
      "localizations": {
        "ar": {
          "stringUnit": {
