        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拾語已暫停"
          }
        }
      }
    },
    "Lingrove started from a simple belief: AI should run on your device, respect your privacy, and remain open to everyone.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأ Lingrove من إيمان بسيط: ينبغي للذكاء الاصطناعي أن يعمل على جهازك، ويحترم خصوصيتك، ويبقى متاحًا للجميع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove basiert auf einer einfachen Überzeugung: KI sollte auf deinem Gerät laufen, deine Privatsphäre respektieren und allen offenstehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove nació de una convicción sencilla: la IA debe ejecutarse en tu dispositivo, respetar tu privacidad y estar abierta a todo el mundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove est né d’une conviction simple : l’IA doit s’exécuter sur votre appareil, respecter votre vie privée et rester ouverte à tous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove की शुरुआत इस सरल विश्वास से हुई कि AI आपके डिवाइस पर चले, आपकी निजता का सम्मान करे और सभी के लिए खुला रहे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove berawal dari keyakinan sederhana: AI harus berjalan di perangkat Anda, menghormati privasi, dan tetap terbuka untuk semua orang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove è nato da una semplice convinzione: l'IA deve funzionare sul tuo dispositivo, rispettare la tua privacy e restare aperta a tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingroveは、AIはデバイス上で動作し、プライバシーを尊重し、誰でも利用できるべきだというシンプルな信念から始まりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove는 AI가 기기에서 실행되고 개인정보를 존중하며 모두에게 열려 있어야 한다는 단순한 믿음에서 시작되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lingrove começou com uma crença simples: a IA deve ser executada no seu dispositivo, respeitar sua privacidade e continuar aberta a todos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove основан на простой идее: ИИ должен работать на вашем устройстве, уважать вашу конфиденциальность и оставаться открытым для всех."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove basit bir inançla başladı: Yapay zekâ aygıtınızda çalışmalı, gizliliğinize saygı göstermeli ve herkese açık kalmalı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾语始终相信一个简单的理念：AI 应在你的设备上运行、尊重你的隐私，并向所有人开放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拾語源自一個簡單信念：AI 應在你的裝置上執行、尊重你的隱私，並對所有人保持開放。"
          }
        }
      }
    },
    "Lingrove will send typed text and any enabled context to this server on your local network.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيرسل Lingrove النص المكتوب وأي سياق مفعّل إلى هذا الخادم على شبكتك المحلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove sendet getippten Text und jeden aktivierten Kontext an diesen Server in deinem lokalen Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove enviará el texto escrito y cualquier contexto activado a este servidor de tu red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove enverra le texte saisi et tout contexte activé à ce serveur sur votre réseau local."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove टाइप किया गया टेक्स्ट और सक्षम संदर्भ आपके स्थानीय नेटवर्क के इस सर्वर को भेजेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove akan mengirim teks yang diketik dan konteks yang diaktifkan ke server ini di jaringan lokal Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove invierà a questo server sulla tua rete locale il testo digitato e qualsiasi contesto abilitato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingroveは入力したテキストと有効にしたコンテキストをローカルネットワーク上のこのサーバーに送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove는 입력한 텍스트와 활성화된 모든 컨텍스트를 로컬 네트워크의 이 서버로 전송합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lingrove enviará o texto digitado e qualquer contexto ativado para este servidor na sua rede local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove отправит на этот сервер в вашей локальной сети набираемый текст и любой включённый контекст."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove, yazdığınız metni ve etkinleştirilmiş bağlamı yerel ağınızdaki bu sunucuya gönderecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾语会将输入文本和任何已启用的上下文发送到本地网络上的此服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拾語會將輸入文字及任何啟用的內容傳送到你區域網路上的這部伺服器。"
          }
        }
      }
    },
    "Lingrove won't autocomplete in these apps. Add an app you can't disable from the menu bar, like a launcher that closes the moment it loses focus.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن ينفّذ Lingrove الإكمال التلقائي في هذه التطبيقات. أضف تطبيقًا لا يمكنك تعطيله من شريط القوائم، مثل مشغّل يُغلق فور فقدان التركيز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove vervollständigt in diesen Apps nichts automatisch. Füge eine App hinzu, die du nicht über die Menüleiste deaktivieren kannst, etwa einen Launcher, der sich schließt, sobald er den Fokus verliert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove no completará texto en estas apps. Añade una app que no puedas desactivar desde la barra de menús, como un lanzador que se cierra en cuanto pierde el foco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove ne fera pas d’autocomplétion dans ces apps. Ajoutez une app que vous ne pouvez pas désactiver depuis la barre des menus, comme un lanceur qui se ferme dès qu’il n’est plus au premier plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन ऐप्स में Lingrove ऑटोकम्प्लीट नहीं करेगा। ऐसा ऐप जोड़ें जिसे मेनू बार से अक्षम नहीं कर सकते, जैसे फ़ोकस हटते ही बंद हो जाने वाला लॉन्चर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove tidak akan memberi pelengkapan otomatis di app ini. Tambahkan app yang tidak dapat dinonaktifkan dari bar menu, seperti peluncur yang langsung tertutup saat kehilangan fokus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove non completerà automaticamente in queste app. Aggiungi un'app che non puoi disabilitare dalla barra dei menu, come un launcher che si chiude non appena perde il focus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingroveはこれらのアプリでは自動補完しません。メニューバーから無効にできない、フォーカスを失うとすぐ閉じるランチャーなどを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove는 이 앱에서 자동 완성하지 않습니다. 메뉴 막대에서 비활성화할 수 없는 앱(포커스를 잃는 즉시 닫히는 런처 등)을 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lingrove não fará preenchimento automático nestes apps. Adicione um app que não possa ser desativado pela barra de menus, como um inicializador que fecha assim que perde o foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove не выполняет автодополнение в этих приложениях. Добавьте приложение, которое нельзя отключить из строки меню, например средство запуска, закрывающееся сразу после потери фокуса."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove bu uygulamalarda otomatik tamamlama yapmaz. Menü çubuğundan devre dışı bırakamayacağınız, odağı kaybettiğinde hemen kapanan bir başlatıcı gibi bir uygulama ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾语不会在这些 App 中自动补全。请添加无法从菜单栏停用的 App，例如失去焦点后立即关闭的启动器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拾語不會在這些 App 中自動完成。請加入無法從選單列停用的 App，例如失去焦點便立即關閉的啟動器。"
          }
        }
      }
    },
    "Lingrove writes in your languages and can address you by name.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتب Lingrove بلغاتك ويمكنه مناداتك باسمك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove schreibt in deinen Sprachen und kann dich mit deinem Namen ansprechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove escribe en tus idiomas y puede dirigirse a ti por tu nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove écrit dans vos langues et peut vous appeler par votre nom."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove आपकी भाषाओं में लिखता है और आपको नाम से संबोधित कर सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove menulis dalam bahasa Anda dan dapat menyapa Anda dengan nama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove scrive nelle tue lingue e può rivolgersi a te per nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingroveはあなたの言語で文章を書き、名前で呼びかけられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove는 사용자의 언어로 작성하고 이름으로 부를 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lingrove escreve nos seus idiomas e pode se dirigir a você pelo nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove пишет на ваших языках и может обращаться к вам по имени."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove sizin dillerinizde yazar ve size adınızla hitap edebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾语会使用你的语言写作，并可用名字称呼你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拾語會使用你的語言寫作，也能用名字稱呼你。"
          }
        }
      }
    },
    "Lingrove — Permissions": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove — الأذونات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove — Berechtigungen"
          }
        },
        "es": {
          "stringUnit": {
