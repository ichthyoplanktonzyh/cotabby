    "Inspect the chunk alignment and look up its words": {
      "comment": "VoiceOver hint describing actions available on an aligned phrase.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افحص مطابقة العبارة وابحث عن كلماتها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phrasenzuordnung prüfen und zugehörige Wörter nachschlagen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecciona la correspondencia de frases y consulta sus palabras en el diccionario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examiner la correspondance de l’expression et rechercher ses mots"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेल खाते वाक्यांश देखें और उनके शब्द डिक्शनरी में खोलें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa kecocokan frasa dan cari kata-katanya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esamina le corrispondenze tra frasi e cerca le singole parole"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーズの対応を確認し、単語を辞書で調べる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구문 대응을 확인하고 단어를 찾아보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecione a correspondência entre as frases e consulte as palavras"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить соответствие фразы переводу и найти её слова в словаре"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İfade eşleşmesini inceleyin ve kelimelerini arayın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看短语对应关系并查询其中的单词"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視語塊對齊並查詢其中的單字"
          }
        }
      }
    },
