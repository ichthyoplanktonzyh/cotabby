    "Remove %@ from Lingrove's local models folder?": {
      "comment": "Confirmation message naming the local model file that will be removed.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة %@ من مجلد النماذج المحلية في Lingrove؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aus Lingroves lokalem Modellordner entfernen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@ de la carpeta de modelos locales de Lingrove?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %@ du dossier des modèles locaux de Lingrove ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove के स्थानीय मॉडल फ़ोल्डर से %@ हटाएँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus %@ dari folder model lokal Lingrove?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere %@ dalla cartella dei modelli locali di Lingrove?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingroveのローカルモデルフォルダから%@を削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove의 로컬 모델 폴더에서 %@을(를) 제거할까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %@ da pasta de modelos locais do Lingrove?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@ из папки локальных моделей Lingrove?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Lingrove'nin yerel modeller klasöründen kaldırılsın mı?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从拾语的本地模型文件夹中移除 %@ 吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要從拾語的本機模型資料夾移除 %@ 嗎？"
          }
        }
      }
    },
    "Remove Lingrove and its data from this Mac.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة Lingrove وبياناته من جهاز Mac هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove und seine Daten von diesem Mac entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina Lingrove y sus datos de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer Lingrove et ses données de ce Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac से Lingrove और उसका डेटा हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus Lingrove dan datanya dari Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi Lingrove e i suoi dati da questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LingroveとそのデータをこのMacから削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 Lingrove와 해당 데이터를 제거합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover o Lingrove e seus dados deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить Lingrove и его данные с этого Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove'yi ve verilerini bu Mac'ten kaldır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从此 Mac 中移除拾语及其数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從此 Mac 移除拾語及其資料。"
          }
        }
      }
    },
    "Remove Lingrove from Applications. To fully clean up model data, delete %@.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزِل Lingrove من مجلد التطبيقات. ولحذف بيانات النماذج بالكامل، احذف %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove aus dem Ordner „Programme“ entfernen. Um Modelldaten vollständig zu bereinigen, lösche %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina Lingrove de Aplicaciones. Para limpiar por completo los datos de modelos, elimina %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer Lingrove des Applications. Pour effacer complètement les données des modèles, supprimez %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Applications से Lingrove हटाएँ। मॉडल डेटा पूरी तरह साफ़ करने के लिए %@ हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus Lingrove dari Aplikasi. Untuk membersihkan data model sepenuhnya, hapus %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi Lingrove dalle Applicazioni. Per eliminare completamente i dati dei modelli, elimina %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingroveをアプリケーションから削除します。モデルデータを完全に消去するには%@を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응용 프로그램에서 Lingrove를 제거합니다. 모델 데이터를 완전히 정리하려면 %@을(를) 삭제하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover o Lingrove de Aplicativos. Para limpar completamente os dados dos modelos, apague %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить Lingrove из приложений. Чтобы полностью очистить данные моделей, удалите %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove'yi Uygulamalar'dan kaldırın. Model verilerini tamamen temizlemek için %@ öğesini silin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“应用程序”中移除拾语。要彻底清理模型数据，请删除 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「應用程式」移除拾語。若要完整清理模型資料，請刪除 %@。"
          }
        }
      }
    },
    "Remove this app's overrides. Lingrove will use the global accept keys here.": {
      "comment": "Lingrove product copy; upstream common wording remains in Localizable.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة تجاوزات هذا التطبيق. سيستخدم Lingrove مفاتيح القبول العامة هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Überschreibungen entfernen. Lingrove verwendet hier die globalen Übernahmetasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las excepciones de esta app. Lingrove usará aquí las teclas de aceptación globales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les remplacements de cette app. Lingrove utilisera ici les touches d’acceptation globales."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ऐप के ओवरराइड हटाएँ। Lingrove यहाँ वैश्विक स्वीकार कुंजियों का उपयोग करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus penggantian app ini. Lingrove akan menggunakan tombol penerimaan global di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi le impostazioni personalizzate di questa app. Qui Lingrove userà i tasti di accettazione globali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリの上書きを削除します。Lingroveはここでグローバルの候補挿入キーを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에 설정된 단축키를 제거합니다. Lingrove가 여기에서 전역 수락 키를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover as substituições deste app. O Lingrove usará aqui as teclas de aceitação globais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить переопределения этого приложения. Здесь Lingrove будет использовать глобальные клавиши принятия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama için özel ayarları kaldırın. Lingrove burada genel kabul tuşlarını kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此 App 的快捷键覆盖设置。拾语将在此处使用全局建议插入快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此 App 的覆寫設定。拾語會在這裡使用全域接受按鍵。"
          }
        }
      }
    },
    "Repeated text could not be located reliably; you can still read the translation and look up words.": {
      "comment": "Status shown when repeated phrases make alignment ambiguous but translation and lookup remain available.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديد مواضع النص المتكرر بثقة؛ لا يزال بإمكانك قراءة الترجمة والبحث عن الكلمات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholter Text ließ sich nicht zuverlässig zuordnen. Du kannst die Übersetzung weiterhin lesen und Wörter nachschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo localizar el texto repetido de forma fiable; aún puedes leer la traducción y consultar palabras en el diccionario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte répété n’a pas pu être localisé de manière fiable ; vous pouvez tout de même lire la traduction et rechercher des mots."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहराए गए पाठांशों का सटीक मिलान नहीं हो सका; आप अनुवाद पढ़ सकते हैं और शब्द डिक्शनरी में देख सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks berulang tidak dapat ditemukan dengan andal; Anda tetap dapat membaca terjemahan dan mencari kata."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile individuare con affidabilità il testo ripetuto; puoi comunque leggere la traduzione e cercare le parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じフレーズが繰り返されているため、対応箇所を確実に特定できませんでした。翻訳の閲覧と単語の検索は引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복되는 텍스트를 안정적으로 찾을 수 없습니다. 번역을 읽고 단어를 찾아볼 수는 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível localizar o texto repetido com segurança; ainda é possível ler a tradução e consultar palavras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось надёжно определить повторяющийся фрагмент; вы по-прежнему можете читать перевод и искать слова в словаре."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yinelenen metnin yeri güvenilir biçimde belirlenemedi; çeviriyi okuyabilir ve kelimeleri arayabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法可靠定位重复文本；你仍可阅读译文并查询单词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法可靠地定位重複文字；你仍可閱讀譯文並查詢單字。"
          }
        }
      }
    },
