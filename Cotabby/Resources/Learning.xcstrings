          }
        }
      }
    },
    "Choose a local GGUF model for this task.": {
      "comment": "Error shown when local generation starts without a selected model.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نموذجًا محليًا بصيغة GGUF لهذه المهمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle für diese Aufgabe ein lokales GGUF-Modell aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un modelo GGUF local para esta tarea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir un modèle GGUF local pour cette tâche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस काम के लिए कोई स्थानीय GGUF मॉडल चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih model GGUF lokal untuk tugas ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un modello GGUF locale per questa attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスク用のローカルGGUFモデルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업에 사용할 로컬 GGUF 모델을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um modelo GGUF local para esta tarefa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите локальную модель GGUF для этой задачи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görev için bir yerel GGUF modeli seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此任务选择一个本地 GGUF 模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請為這項工作選擇本機 GGUF 模型。"
          }
        }
      }
    },
    "Choose a local GGUF or a separate endpoint for sentence translation. A translation-focused model is recommended.": {
      "comment": "Description of the translation task's engine setting.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نموذجًا محليًا بصيغة GGUF أو نقطة نهاية منفصلة لترجمة الجمل. يُوصى بنموذج مخصص للترجمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle für die Satzübersetzung ein lokales GGUF-Modell oder einen separaten Endpunkt aus. Ein auf Übersetzungen spezialisiertes Modell wird empfohlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un GGUF local o un endpoint independiente para traducir oraciones. Se recomienda un modelo especializado en traducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un GGUF local ou un endpoint distinct pour traduire les phrases. Un modèle spécialisé dans la traduction est recommandé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वाक्य के अनुवाद के लिए स्थानीय GGUF मॉडल या अलग एंडपॉइंट चुनें। अनुवाद के लिए विशेष रूप से बनाया गया मॉडल सुझाया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih model GGUF lokal atau endpoint terpisah untuk menerjemahkan kalimat. Disarankan menggunakan model khusus terjemahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un modello GGUF locale o un endpoint separato per tradurre le frasi. È consigliato un modello specializzato nella traduzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文の翻訳には、ローカルGGUFモデルまたは別のエンドポイントを選択してください。翻訳向けモデルをおすすめします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업에서 문장을 번역할 로컬 GGUF 또는 별도 엔드포인트를 선택하세요. 번역에 특화된 모델을 권장합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um GGUF local ou um endpoint separado para traduzir frases. Recomendamos um modelo especializado em tradução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите локальную модель GGUF или отдельный эндпоинт для перевода предложений. Рекомендуется модель, предназначенная для перевода."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cümle çevirisi için yerel bir GGUF modeli veya ayrı bir uç nokta seçin. Çeviri odaklı bir model önerilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为句子翻译选择本地 GGUF 模型或单独的端点。建议使用专门用于翻译的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇本機 GGUF 模型或另一個端點來翻譯句子。建議使用專為翻譯設計的模型。"
          }
        }
      }
    },
    "Choose a local instruction-tuned GGUF or a separate endpoint for chunk alignment. Only confirmed source and translation text is aligned.": {
      "comment": "Description of the chunk-alignment task's engine setting.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نموذجًا محليًا بصيغة GGUF مضبوطًا على اتباع التعليمات، أو نقطة نهاية منفصلة لمطابقة العبارات. تقتصر المطابقة على مقاطع النص المصدر والترجمة التي تم التحقق منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle für die Phrasenzuordnung ein lokal gespeichertes, instruktionsoptimiertes GGUF-Modell oder einen separaten Endpunkt aus. Es werden nur bestätigte Abschnitte aus Ausgangstext und Übersetzung einander zugeordnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un GGUF local ajustado para seguir instrucciones o un endpoint independiente para la correspondencia de frases. Solo se alinean textos de origen y de traducción confirmados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un GGUF local ajusté pour suivre des instructions ou un endpoint distinct pour la correspondance des expressions. Seuls les textes source et cible confirmés sont mis en correspondance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वाक्यांश मिलान के लिए निर्देशों के अनुसार ट्यून किया गया स्थानीय GGUF मॉडल या अलग एंडपॉइंट चुनें। केवल पुष्ट स्रोत और अनुवाद पाठ का मिलान किया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih model GGUF lokal yang mengikuti instruksi atau endpoint terpisah untuk pencocokan frasa. Hanya teks sumber dan terjemahan yang telah dikonfirmasi yang dicocokkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un modello GGUF locale ottimizzato per seguire istruzioni o un endpoint separato per allineare le frasi. Vengono allineati solo segmenti confermati del testo originale e della traduzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーズ照合には、ローカルの指示チューニング済みGGUFモデルまたは別のエンドポイントを選択してください。照合するのは確定済みの原文と訳文だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구문 대응에 사용할 지시문 튜닝 로컬 GGUF 또는 별도 엔드포인트를 선택하세요. 확인된 원문과 번역 텍스트만 정렬됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um GGUF local ajustado para seguir instruções ou um endpoint separado para corresponder trechos entre a origem e a tradução. Somente textos de origem e tradução confirmados são alinhados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите локальную модель GGUF, настроенную на выполнение инструкций, или отдельный эндпоинт для сопоставления фраз. Сопоставляются только подтверждённые исходный текст и перевод."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İfade eşleştirme için talimatlarla ince ayarlanmış yerel bir GGUF modeli veya ayrı bir uç nokta seçin. Yalnızca doğrulanmış kaynak metin ve çeviri eşleştirilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为语块对齐选择本地指令微调 GGUF 模型或单独的端点。只会对齐已确认的原文和译文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇本機指令微調 GGUF 模型或另一個端點來進行語塊對齊。只會對齊已確認的原文與譯文。"
          }
        }
