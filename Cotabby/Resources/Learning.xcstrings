    "Get inline completions, translate sentences, and learn expressions.": {
      "comment": "Lingrove: autocomplete and language learning are equally core capabilities.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على إكمال داخل النص وترجم الجمل وتعلّم التعبيرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Inline-Vervollständigungen, übersetze Sätze und lerne Ausdrücke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get inline completions, translate sentences, and learn expressions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén autocompletado en línea, traduce frases y aprende expresiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profitez de l’autocomplétion, traduisez des phrases et apprenez des expressions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनलाइन सुझाव पाएँ, वाक्यों का अनुवाद करें और अभिव्यक्तियाँ सीखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan pelengkapan langsung, terjemahkan kalimat, dan pelajari ungkapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il completamento in linea, traduci frasi e impara espressioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インライン補完を使い、文を翻訳し、表現を学びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인라인 자동 완성을 사용하고, 문장을 번역하고, 표현을 배우세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o preenchimento automático em linha, traduza frases e aprenda expressões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте автодополнение, переводите предложения и изучайте выражения."
          }
        },
        "tr": {
