          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾语准备好提供建议时，在输入框边缘显示小图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拾語準備好提供建議時，在輸入欄位邊緣顯示小圖示。"
          }
        }
      }
    },
    "Show sentence expressions after a pause": {
