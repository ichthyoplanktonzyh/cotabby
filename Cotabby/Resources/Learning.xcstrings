          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra una piccola icona sul bordo di un campo quando Lingrove è pronto a suggerire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingroveが候補を表示できる状態になると、フィールドの端に小さなアイコンを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
