    "Follow global history collection, or stop recording in this app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتباع إعداد جمع السجل العام أو إيقاف التسجيل في هذا التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Globale Verlaufseinstellung übernehmen oder Eingaben dieser App nicht aufzeichnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow global history collection, or stop recording in this app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue el ajuste global del historial o deja de registrar esta aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivre le réglage global de collecte ou arrêter l’enregistrement dans cette app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैश्विक इतिहास सेटिंग अपनाएँ या इस ऐप में रिकॉर्डिंग बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti pengaturan riwayat global atau hentikan perekaman aplikasi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui l’impostazione globale della cronologia o interrompi la registrazione in questa app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全体の履歴設定に従うか、このアプリでの記録を停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전역 기록 수집 설정을 따르거나 이 앱의 기록을 중지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga o ajuste global do histórico ou pare de registrar este app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
